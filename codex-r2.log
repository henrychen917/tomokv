            if (prepared != WorkError::None) {
                state.final_reply = FinalReply::Work;
                state.final_error = prepared;
                return final();
            }
            if (sort_deref_gathering(state)) {
                if (publish_sort_deref(server, self, ring, task, state))
                    return ScatterFinish::Waiting;
                return final();
            }
            const WorkError finished = finish_sort_deref(state);
            if (finished != WorkError::None) {
                state.final_reply = FinalReply::Work;
                state.final_error = finished;
                return final();
            }
            restore_sort_source_groups(state);
        } else if (sort_deref_gathering(state)) {
            const WorkError finished = finish_sort_deref(state);
            if (finished != WorkError::None) {
                state.final_reply = FinalReply::Work;
                state.final_error = finished;
                return final();
            }
            restore_sort_source_groups(state);
        }
    }
    // Once the last owner has materialized its result, this read cut protects no future
    // dereference. Value borrows have their own store lifetime pins. Tell the owning IO to advance
    // its floor even if ordered reply retirement is still behind a deep pipeline.
    if ((!state.two_hop || state.phase == 2) && state.snapshot_registered &&
        !state.snapshot_complete.exchange(true, std::memory_order_acq_rel))
        server.note_atomic_snapshot_complete(state.owner_io);
    if (state.atomic_write) {
        WorkError error;
        if (first_error(state, error)) {
            state.aborted.store(true, std::memory_order_release);
            aof_abort_scatter_group(state);
            state.final_reply = FinalReply::Work;
            state.final_error = error;
            return final();
        }
        if (state.aborted.load(std::memory_order_acquire)) {
            aof_abort_scatter_group(state);
            // MSETNX existence is a normal failed condition, not a work error. Its installed
            // candidates (if another owner got that far) remain forever invisible at epoch zero.
            if (state.kind == Kind::Msetnx) {
                state.final_reply = FinalReply::Integer;
                state.final_integer = 0;
            } else {
                state.final_reply = FinalReply::Internal;
            }
            return final();
        }
        if (!state.external_epoch) {
            const uint64_t ticket = server.atomic_commit_group(state.epoch);
            aof_commit_scatter_group(state, self, ring, ticket);
        }
        if (state.kind == Kind::Msetnx) {
            state.final_reply = FinalReply::Integer;
            state.final_integer = 1;
        }
        return final();
    }
    if (state.phase == 2) {
        finish_phase2(state);
        if (state.aof_group) {
            uint64_t ticket = state.epoch.load(std::memory_order_acquire);
            if (!ticket && state.atomic_pop &&
                (state.final_reply == FinalReply::Lmpop ||
                 state.final_reply == FinalReply::Zmpop)) {
                ticket = server.atomic_commit_group(state.epoch);
            }
            if (ticket && !state.aborted.load(std::memory_order_acquire))
                aof_commit_scatter_group(state, self, ring, ticket);
            else
                aof_abort_scatter_group(state);
        }
        if (__builtin_expect(server.blocking_waiters() != 0, false))
            blocking_atomic_published(server, self, ring, state);
        return final();
    }
    if (state.kind == Kind::Pfcount) {
        finish_pfcount(state);
        return final();
    }
    if (state.kind == Kind::Lcs) {
        finish_lcs(state);
        return final();
    }
    if (!state.two_hop) return final();
    if (finish_phase1(state, op)) {
        return final();
    }
    if (publish_phase2(server, self, ring, task, state)) return ScatterFinish::Waiting;
    return final();
}

enum class MultiChildFinish : uint8_t { Waiting, PhaseAdvanced, Final };

void xshard_multi_child_bind(ScatterState& state, std::atomic<uint64_t>* epoch,
                             std::atomic<bool>* aborted) {
    state.external_epoch = epoch;
    state.external_aborted = aborted;
}

bool xshard_multi_child_has_group(ScatterState& state, int32_t shard) {
    return group_for(state, shard) != nullptr;
}

bool xshard_multi_child_records_done(const ScatterState& state) {
    return state.record_refs.load(std::memory_order_acquire) == 0 &&
           state.watch_refs.load(std::memory_order_acquire) == 0;
}

MultiChildFinish xshard_multi_child_complete(ScatterState& state, Op& op,
                                             uint32_t owner_thread_id) {
    if (state.atomic_write || (state.atomic_apply && state.phase == 2)) {
        const uint32_t slot = state.server->executor_slot(owner_thread_id);
        if (slot >= state.owner_slots) std::abort();
        uint32_t& remaining = state.owner_record_refs[slot].remaining;
        if (!remaining) std::abort();
        if (--remaining != 0) return MultiChildFinish::Waiting;
    }
    if (state.pending.fetch_sub(1, std::memory_order_acq_rel) != 1)
        return MultiChildFinish::Waiting;
    if (state.atomic_pop && state.phase == 2 && state.pop_missed) {
        state.final_reply = FinalReply::NullArray;
        return MultiChildFinish::Final;
    }
    if (state.kind == Kind::Sort && state.sort_options.deref && state.phase == 1) {
        if (state.sort_deref->wave == SortDerefWave::Source) {
            WorkError source_error;
            if (first_error(state, source_error)) {
                state.final_reply = FinalReply::Work;
                state.final_error = source_error;
                return MultiChildFinish::Final;
            }
            const WorkError prepared = prepare_sort_deref(state, op);
            if (prepared != WorkError::None) {
                state.final_reply = FinalReply::Work;
                state.final_error = prepared;
                return MultiChildFinish::Final;
            }
            if (sort_deref_gathering(state)) {
                state.pending.store(state.nsub, std::memory_order_release);
                return MultiChildFinish::PhaseAdvanced;
            }
            const WorkError finished = finish_sort_deref(state);
            if (finished != WorkError::None) {
                state.final_reply = FinalReply::Work;
                state.final_error = finished;
                return MultiChildFinish::Final;
            }
            restore_sort_source_groups(state);
        } else if (sort_deref_gathering(state)) {
            const WorkError finished = finish_sort_deref(state);
            if (finished != WorkError::None) {
                state.final_reply = FinalReply::Work;
                state.final_error = finished;
                return MultiChildFinish::Final;
            }
            restore_sort_source_groups(state);
        }
    }
    if (state.atomic_write) {
        WorkError error;
        if (first_error(state, error)) {
            state.aborted.store(true, std::memory_order_release);
            state.final_reply = FinalReply::Work;
            state.final_error = error;
            return MultiChildFinish::Final;
        }
        if (state.aborted.load(std::memory_order_acquire)) {
            if (state.kind == Kind::Msetnx) {
                state.final_reply = FinalReply::Integer;
                state.final_integer = 0;
            } else {
                state.final_reply = FinalReply::Internal;
            }
            return true;
        const uint64_t available = matches.size() - offset;
        const uint64_t take = options.limit < 0
            ? available : std::min<uint64_t>(available, static_cast<uint64_t>(options.limit));
        selected.reserve(static_cast<size_t>(take));
        for (uint64_t i = 0; i < take; i++) {
            const size_t match = options.reverse
                ? matches[matches.size() - 1 - static_cast<size_t>(offset + i)]
                : matches[static_cast<size_t>(offset + i)];
            selected.push_back(input[match]);
        }
    } catch (const std::bad_alloc&) {
        selected.clear();
        return false;
    }
    return true;
}

// Decode the source at its natural order and build the stable option spec. Dereferencing SORT keeps
// both objects in its arena sidecar across the owner-grouped gather wave; ordinary SORT immediately
// passes them to sort_image_finish below.
WorkError sort_image_prepare(const ObjectImage& image, const Op& op, const SortOptions& options,
                             SortSpec& spec, std::vector<std::string>& elements) {
    spec = SortSpec{};
    elements.clear();
    if (!image.present) return WorkError::None;
    if (image.type != Type::List && image.type != Type::Set && image.type != Type::Zset)
        return WorkError::WrongType;
    try {
        if (image.type == Type::Zset) {
            std::vector<ZImageItem> zitems;
            if (!decode_zset_image(image, zitems)) return WorkError::Corrupt;
            elements.reserve(zitems.size());
            for (ZImageItem& item : zitems) elements.push_back(std::move(item.member));
        } else if (!decode_elements(image, elements)) {
            return WorkError::Corrupt;
        }
        spec.alpha = options.alpha;
        spec.descending = options.descending;
        spec.store = options.store;
        spec.offset = options.offset;
        spec.count = options.count;
        spec.source_is_set = image.type == Type::Set;
        spec.source_is_list = image.type == Type::List;
        spec.by_given = options.by_arg != 0;
        if (spec.by_given) {
            sort_pattern_parse(op.arg(options.by_arg), spec.by);
            spec.dontsort = !spec.by.has_star;
        }
        spec.gets.reserve(options.get_args.size());
        for (uint32_t arg : options.get_args) {
            SortPattern pattern;
            sort_pattern_parse(op.arg(arg), pattern);
            spec.gets.push_back(pattern);
        }
    } catch (const std::bad_alloc&) {
        elements.clear();
        return WorkError::Oom;
    }
    return WorkError::None;
}

WorkError sort_image_finish(const SortSpec& spec, const SortResolved* resolved,
                            std::vector<std::string>& elements,
                            std::vector<std::string>& values, std::vector<uint8_t>& present,
                            bool& conversion_error) {
    conversion_error = false;
    switch (sort_run(spec, resolved, elements, values, present)) {
        case SortStatus::Ok: return WorkError::None;
        case SortStatus::ConversionError:
            conversion_error = true;
            values.clear();
            present.clear();
            return WorkError::None;
        case SortStatus::Oom: return WorkError::Oom;
    }
    return WorkError::None;
}

// ONE ordering implementation for every SORT form: `sort_run` in src/cmd/t_sort.cc. This wrapper
// is the immediate path for forms with no dynamic gather.
WorkError sort_image(const ObjectImage& image, const Op& op, const SortOptions& options,
                     const SortResolved* resolved,
                     std::vector<std::string>& values, std::vector<uint8_t>& present,
                     bool& conversion_error) {
    SortSpec spec;
    std::vector<std::string> elements;
    const WorkError prepared = sort_image_prepare(image, op, options, spec, elements);
    if (prepared != WorkError::None) {
        conversion_error = false;
        values.clear();
        present.clear();
        return prepared;
    }
    return sort_image_finish(spec, resolved, elements, values, present, conversion_error);
}

// A stored SORT result is always a list of plain strings: an absent GET becomes an empty element,
// which is what the reference stores too.
bool sort_encode_store(const std::vector<std::string>& values,
                       const std::vector<uint8_t>& present, ObjectImage& image) {
    std::vector<std::string> flat;
    try {
        flat.reserve(values.size());
        for (size_t i = 0; i < values.size(); i++)
            flat.push_back(i < present.size() && !present[i] ? std::string() : values[i]);
    } catch (const std::bad_alloc&) {
        return false;
    }
    return encode_elements(flat, image, Type::List, -1);
}

