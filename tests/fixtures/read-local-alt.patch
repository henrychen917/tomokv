+// Measurement candidate: exchange the existing ANDN for a same-width jump.
+// The island inherits the emitting COMDAT group and returns without touching
+// the stack. Its only extra mutation is the covered MGET fence release.
+#if defined(__x86_64__) && defined(__BMI__)
+asm(R"(
+.ifdef tomo_rlfence_text_pad
+    .pushsection .text.rlfence_pad,"ax",@progbits
+    .fill tomo_rlfence_text_pad, 1, 0x90
+    .popsection
+.endif
+.macro tomo_rlfence_retire pending, bits, fence
+    jmp 991f
+    .pushsection .rlfence,"ax?",@progbits
+991:
+    movq \fence, %rsi
+    btq %rsi, \bits
+    jnc 992f
+    movq $-1, \fence
+992:
+    andn \pending, \bits, \bits
+    jmp 993f
+    .popsection
+993:
+.endm
+)");
+#endif
