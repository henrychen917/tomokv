  1862	struct ScriptAccessScope {
  1863	    explicit ScriptAccessScope(Op& op, uint8_t* access, uint32_t count) {
  1864	        script_cross_access_begin(op, access, count);
  1865	    }
  1866	    ~ScriptAccessScope() { script_cross_access_end(); }
  1867	};
  1868	
  1869	ScatterTaskResult execute_script_phase(const Task& task, Shard& shard, Op& op) {
  1870	    ScatterState& state = *task.scatter;
  1871	    ShardGroup* group = group_for(state, shard.id());
  1872	    if (state.script_resume_post) return ScatterTaskResult::Complete;
  1873	    if (!group && state.script_phase != ScriptPhase::Run) std::abort();
  1874	
  1875	    switch (state.script_phase) {
  1876	        case ScriptPhase::Pin: {
  1877	            for (uint32_t i = 0; i < group->count; i++) {
  1878	                const uint32_t pos = state.key_order[group->begin + i];
  1879	                const KeyRef& key = state.keys[pos];
  1880	                if (state.aborted.load(std::memory_order_acquire)) break;
  1881	#ifdef TOMO_XSCRIPT_NO_RESERVE
  1882	                // NEGATIVE-CONTROL BUILD ONLY (make noreserve). Everything else about the
  1883	                // activation is unchanged -- same waves, same cut, same validation -- so a battery
  1884	                // that passes here is a battery that was never testing the reservation.
  1885	                continue;
  1886	#endif
  1887	                if (!shard.store().atomic_script_pin(key.hash, op.arg(key.arg))) {
  1888	                    group->error = WorkError::Oom;
  1889	                    state.aborted.store(true, std::memory_order_release);
  1890	                    break;
  1891	                }
  1892	                state.server->note_script_key_armed();
  1893	                state.script_pinned[pos] = 1;
  1894	            }
  1895	            return ScatterTaskResult::Complete;
  1896	        }
  1897	        case ScriptPhase::Read: {
  1898	            if (state.aborted.load(std::memory_order_acquire))
  1899	                return ScatterTaskResult::Complete;
  1900	            // The owner's expiry cut is already state.now_cut_ms: xshard_execute installed it
  1901	            // before dispatching this phase, and it is the same instant every other owner of this
  1902	            // script is reading against.
  1903	            shard.store().atomic_set_read_context(state.script_cut, state.origin_conn_id);
  1904	            uint64_t local_bytes = 0;
  1905	            for (uint32_t i = 0; i < group->count; i++) {
  1906	                const uint32_t pos = state.key_order[group->begin + i];
  1907	                const KeyRef& key = state.keys[pos];
  1908	                KvObj* value = shard.store().find(key.hash, op.arg(key.arg));
  1909	                if (!serialize_object(value, state.images[pos])) {
  1910	                    group->error = WorkError::Oom;
  1911	                    state.aborted.store(true, std::memory_order_release);
  1912	                    break;
  1913	                }
  1914	                local_bytes += sizeof(ObjectImage) + op.arg(key.arg).n +
  1915	                               state.images[pos].payload.size();
  1916	            }
  1917	            shard.store().atomic_clear_read_epoch();
  1918	            const uint64_t total = state.script_staged_bytes.fetch_add(
  1919	                local_bytes, std::memory_order_relaxed) + local_bytes;
  1920	            state.server->note_script_stage_owner(local_bytes);
  1921	            if (total > state.server->script_crossshard_max_bytes()) {
  1922	                state.script_stage_limit = true;
  1923	                group->error = WorkError::Oom;
  1924	                state.aborted.store(true, std::memory_order_release);
  1925	            }
  1926	            return ScatterTaskResult::Complete;
  1927	        }
  1928	        case ScriptPhase::Run: {
  1929	            state.server->note_script_run();
  1930	            Shard* work = script_workbench(*state.server, state.script_coordinator_shard);
  1931	            work->store().clear();
  1932	            // The workbench is a shard object of its own, so xshard_execute's cut does not reach
  1933	            // it; give it the same instant explicitly.
  1934	            work->pin_now_ms(state.now_cut_ms);
  1935	            for (uint32_t pos = 0; pos < state.key_count; pos++) {
  1936	                const KeyRef& key = state.keys[pos];
  1937	                const WorkError loaded = apply_image<false>(
  1938	                    *work, op.arg(key.arg), key.hash, state.images[pos], true);
  1939	                if (loaded != WorkError::None) {
  1940	                    state.final_error = loaded;
  1941	                    state.aborted.store(true, std::memory_order_release);
  1942	                    return ScatterTaskResult::Complete;
  1943	                }
  1944	            }
  1945	            if (work->store().object_bytes() >
  1946	                state.server->script_crossshard_workbench_bytes()) {
  1947	                state.final_error = WorkError::Maxmemory;
  1948	                state.aborted.store(true, std::memory_order_release);
  1949	                return ScatterTaskResult::Complete;
  1950	            }
  1951	            op.reply.clear();
  1952	            op.direct_len = 0;
  1953	            {
  1954	                ScriptAccessScope access(op, state.status, state.key_count);
  1955	                op.spec->handler(*work, op);
  1956	            }
  1957	            if (work->store().object_bytes() >
  1958	                state.server->script_crossshard_workbench_bytes()) {
  1959	                state.final_error = WorkError::Maxmemory;
  1960	                state.aborted.store(true, std::memory_order_release);
  1961	                return ScatterTaskResult::Complete;
  1962	            }
  1963	            for (uint32_t pos = 0; pos < state.key_count; pos++) {
  1964	                if (!(state.status[pos] & 2u)) continue;
  1965	                const KeyRef& key = state.keys[pos];
  1966	                KvObj* value = work->store().find(key.hash, op.arg(key.arg));
  1967	                if (!serialize_object(value, state.apply[pos])) {
  1968	                    state.final_error = WorkError::Oom;
  1969	                    state.aborted.store(true, std::memory_order_release);
  1970	                    break;
  1971	                }
  1972	            }
  1973	            return ScatterTaskResult::Complete;
  1974	        }
  1975	        case ScriptPhase::Validate:
  1976	            state.server->note_script_validate_owner();
  1977	            for (uint32_t i = 0; i < group->count; i++) {
  1978	                const uint32_t pos = state.key_order[group->begin + i];
  1979	                const KeyRef& key = state.keys[pos];
  1980	                if (shard.store().atomic_script_changed(
  1981	                        key.hash, op.arg(key.arg), state.script_cut)) {
  1982	                    state.script_conflict.store(true, std::memory_order_release);
  1983	                    break;
  1984	                }
  1985	            }
  1986	            return ScatterTaskResult::Complete;
  1987	        case ScriptPhase::Unpin:
  1988	            for (uint32_t i = 0; i < group->count; i++) {
  1989	                const uint32_t pos = state.key_order[group->begin + i];
  1990	                if (!state.script_pinned[pos]) continue;
  1991	                const KeyRef& key = state.keys[pos];
  1992	                shard.store().atomic_script_unpin(key.hash, op.arg(key.arg));
  1993	                state.server->note_script_key_released();
  1994	                state.script_pinned[pos] = 0;
  1995	            }
  1996	            return ScatterTaskResult::Complete;
  1997	        case ScriptPhase::Apply:
  1998	        case ScriptPhase::None:
  1999	            break;
  2000	    }
  2001	    return ScatterTaskResult::Complete;
  2002	}
  2003	
  2004	bool xshard_owner_mutation_phase(const ScatterState& state, const Op& op) {
  2005	    if (state.kind == Kind::Script && state.script_resume_post) return false;
  2006	    if (!(op.spec->flags & (CmdFlags::Write | CmdFlags::SnapshotWrite))) return false;
  2007	    if (state.atomic_write) return true;
  2008	    if (state.atomic_apply || state.atomic_pop || state.two_hop) return state.phase == 2;
  2009	    return true;
  2010	}
  2011	
  2012	}  // namespace
  2013	
  2014	ScatterTaskResult xshard_execute(const Task& task, Shard& shard, Op& op,
  2015	                                 uint32_t owner_thread_id) {
  2016	    const bool notify = (op.spec->flags & CmdFlags::NotifySelected) != 0;
  2017	    NotifyExecutionScope notify_scope(shard, op, notify, shard.notify_order_base());
  2018	    ScatterState& state = *task.scatter;
  2019	    // ONE EXPIRY CUT FOR THE WHOLE FAN-OUT. Before this, each fragment compared deadlines against
  2020	    // its own executor's per-pass clock, so an eight-owner MGET could report a key alive on one
  2021	    // owner and elapsed on another -- a keyspace that existed at no instant. Cheap enough to be
  2022	    // unconditional on the cross-shard path: two stores in, two out, and single-shard commands
  2023	    // never reach this function at all.
  2024	    PinnedNowMs now_cut(shard, state.now_cut_ms);
  2025	    if (state.kind == Kind::Script &&
  2026	        (state.script_phase != ScriptPhase::Apply || state.script_resume_post))
  2027	        return execute_script_phase(task, shard, op);
  2028	    ShardGroup& group = *group_for(state, shard.id());
  2029	    if (xshard_owner_mutation_phase(state, op) && shard.has_watches()) {
  2030	        const void* token = state.atomic_group ? static_cast<const void*>(&state) : nullptr;
  2031	        if (group.count == 0) {
  2032	            if (!shard.watch_all_write_ready()) return ScatterTaskResult::Retry;
  2033	        } else {
  2034	            for (uint32_t i = 0; i < group.count; i++) {
  2035	                const uint32_t pos = state.key_order[group.begin + i];
  2036	                const KeyRef& key = state.keys[pos];
  2037	                if (!shard.watch_write_ready(op.arg(key.arg), token))
  2038	                    return ScatterTaskResult::Retry;
  2039	            }
  2040	            if (state.atomic_group) {
  2041	                for (uint32_t i = 0; i < group.count; i++) {
  2042	                    const uint32_t pos = state.key_order[group.begin + i];
  2043	                    const KeyRef& key = state.keys[pos];
  2044	                    shard.watch_reserve_write(
  2045	                        op.arg(key.arg), task.client, task.client->watch_generation(), &state,
  2046	                        publish_epoch(state), publish_aborted(state), &state.watch_refs);
  2047	                }
  2048	            }
  2049	        }
  2050	    }
  2960	            }
  2961	            case ScriptPhase::None:
  2962	                std::abort();
  2963	        }
  2964	        std::abort();
  2965	    }
  2966	}
  2967	
  2968	ScatterFinish xshard_complete(Server& server, ThreadCtx& self, Ring& ring,
  2969	                              const Task& task, Op& op) {
  2970	    ScatterState& state = *task.scatter;
  2971	    if (state.kind == Kind::Script)
  2972	        return xshard_complete_script(server, self, ring, task, op, state);
  2973	    auto final = [&]() {
  2974	        if (op.spec->flags & CmdFlags::NotifySelected)
  2975	            notify_xshard_finished(server.shard(task.shard), op, state);
  2976	        // Every participating owner has installed its share of this group -- this is the last
  2977	        // owner, running on an EX thread. That is the instant the group stops being able to
  2978	        // straddle a snapshot cut, and it is much earlier than reply retirement, which happens on
  2979	        // the admitting IO thread (the very thread a blocking SAVE occupies).
  2980	        server.atomic_apply_close(state.apply_open);
  2981	        return ScatterFinish::Final;
  2982	    };
  2983	    if (state.atomic_write || (state.atomic_apply && state.phase == 2)) {
  2984	        const uint32_t slot = server.executor_slot(self.id());
  2985	        if (slot >= state.owner_slots) std::abort();
  2986	        uint32_t& remaining = state.owner_record_refs[slot].remaining;
  2987	        if (!remaining) std::abort();
  2988	        if (--remaining != 0) return ScatterFinish::Waiting;
  2989	    }
  2990	    if (state.pending.fetch_sub(1, std::memory_order_acq_rel) != 1)
  2991	        return ScatterFinish::Waiting;
  2992	    if (state.atomic_pop && state.phase == 2 && state.pop_missed) {
  2993	        aof_abort_scatter_group(state);
  2994	        state.aof_group.reset();
  2995	        static constexpr uint32_t kMaxPopRetries = 8;
  2996	        if (state.pop_retries++ < kMaxPopRetries &&
  2997	            publish_pop_retry(server, self, ring, task, state))
  2998	            return ScatterFinish::Waiting;
  2999	        if (state.final_reply == FinalReply::QueueFull) return final();
  3000	        state.final_reply = FinalReply::NullArray;
  3001	        return final();
  3002	    }
  3003	    // Once the last owner has materialized its result, this read cut protects no future
  3004	    // dereference. Value borrows have their own store lifetime pins. Tell the owning IO to advance
  3005	    // its floor even if ordered reply retirement is still behind a deep pipeline.
  3006	    if ((!state.two_hop || state.phase == 2) && state.snapshot_registered &&
  3007	        !state.snapshot_complete.exchange(true, std::memory_order_acq_rel))
  3008	        server.note_atomic_snapshot_complete(state.owner_io);
  3009	    if (state.atomic_write) {
  3010	        WorkError error;
  3011	        if (first_error(state, error)) {
  3012	            state.aborted.store(true, std::memory_order_release);
  3013	            aof_abort_scatter_group(state);
  3014	            state.final_reply = FinalReply::Work;
  3015	            state.final_error = error;
  3016	            return final();
  3017	        }
  3018	        if (state.aborted.load(std::memory_order_acquire)) {
  3019	            aof_abort_scatter_group(state);
  3020	            // MSETNX existence is a normal failed condition, not a work error. Its installed
  3021	            // candidates (if another owner got that far) remain forever invisible at epoch zero.
  3022	            if (state.kind == Kind::Msetnx) {
  3023	                state.final_reply = FinalReply::Integer;
  3024	                state.final_integer = 0;
  3025	            } else {
  3026	                state.final_reply = FinalReply::Internal;
  3027	            }
  3028	            return final();
  3029	        }
  3030	        if (!state.external_epoch) {
  3031	            const uint64_t ticket = server.atomic_commit_group(state.epoch);
  3032	            aof_commit_scatter_group(state, self, ring, ticket);
  3033	        }
  3034	        if (state.kind == Kind::Msetnx) {
  3035	            state.final_reply = FinalReply::Integer;
  3036	            state.final_integer = 1;
  3037	        }
  3038	        return final();
  3039	    }
  3040	    if (state.phase == 2) {
  3041	        finish_phase2(state);
  3042	        if (state.aof_group) {
  3043	            uint64_t ticket = state.epoch.load(std::memory_order_acquire);
  3044	            if (!ticket && state.atomic_pop &&
  3045	                (state.final_reply == FinalReply::Lmpop ||
