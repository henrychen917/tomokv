   981	void assemble_cross_reply(MultiCommand& command) {
   982	    Op& op = *command.op;
   983	    if (command.kind == MultiCommandKind::Mget) {
   984	        reply_array_header(op.sink(), command.values.size());
   985	        for (const MultiValue& value : command.values) {
   986	            if (!value.present) reply_null(op.sink(), op.resp3());
   987	            else reply_bulk(op.sink(), Slice(value.value.data(),
   988	                                              static_cast<uint32_t>(value.value.size())));
   989	        }
   990	    } else if (command.kind == MultiCommandKind::Mset) {
   991	        reply_ok(op.sink());
   992	    } else if (command.kind == MultiCommandKind::Msetnx) {
   993	        reply_int(op.sink(), command.condition_failed.load(std::memory_order_acquire) ? 0 : 1);
   994	    } else if (command.kind == MultiCommandKind::Del ||
   995	               command.kind == MultiCommandKind::Exists) {
   996	        reply_int(op.sink(), command.integer.load(std::memory_order_relaxed));
   997	    } else if (command.kind == MultiCommandKind::Ping) {
   998	        if (op.argc() == 1) reply_pong(op.sink());
   999	        else reply_bulk(op.sink(), op.arg(1));
  1000	    } else if (command.kind == MultiCommandKind::Echo) {
  1001	        reply_bulk(op.sink(), op.arg(1));
  1002	    } else if (command.kind == MultiCommandKind::UnwatchReply) {
  1003	        reply_ok(op.sink());
  1004	    } else {
  1005	        reply_err(op.sink(), "ERR command is not supported by MULTI execution");
  1006	    }
  1007	}
