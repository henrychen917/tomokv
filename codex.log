   790	// The cut this command reads at. IO pinned it in the connection's program order (Op::read_cut_lo);
   791	// `now` is a sequence value this owner has already loaded, which is all the widening needs. An
   792	// unstamped op -- a write, or any op parsed while the engine had no atomic tracking at all -- keeps
   793	// the newest world, exactly as before.
   794	uint64_t plain_read_cut(Server& server, const Op& op, uint64_t now) {
   795	    if (!op.has_read_cut()) return now;
   796	    const uint64_t cut = op.read_cut(now);
   797	    if (cut != now) server.note_atomic_read_cut_held();
   798	    return cut;
   799	}
