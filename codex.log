   647	size_t arena_layout_bytes(Kind kind, uint32_t key_count, uint32_t group_cap,
   648	                          uint32_t shard_slots, bool atomic_write, bool atomic_apply,
   649	                          uint32_t owner_slots) {
   650	    const bool atomic_install = atomic_write || atomic_apply;
