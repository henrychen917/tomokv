   867	bool execute_local_command(Server& server, MultiExecState& state, MultiCommand& command,
   868	                           Shard& shard, uint32_t owner_thread_id) {
   869	    if (!prepare_local_write_keys(server, state, command, shard, owner_thread_id)) return false;
   870	    if (command.op->spec->flags & CmdFlags::NotifySelected)
   871	        notify_execute_source(shard, *command.op, command.notify_order_base);
   872	    shard.store().atomic_set_read_context(UINT64_MAX, state.origin_conn_id);
   873	    command.op->spec->handler(shard, *command.op);
   874	    complete_child_zc(shard, *command.op);
   875	    shard.store().atomic_clear_read_epoch();
   876	    return true;
   877	}
