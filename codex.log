   391	def phase_ryow(c, one_executor):
   392	    """Read-your-own-writes across the dereference.
   393	
   394	    REGRESSION PIN. The read cut and the originating connection are per-shard state that the owning
   395	    task binds only on the shard it was posted for. A dereference reads OTHER shards, and reading
   396	    them at "latest, no connection" hides this connection's own not-yet-committed group -- so a
   397	    weight key written by the immediately preceding MSET read back as absent, and only on the boots
   398	    whose hash seed placed it off the source's shard. The loop below writes the weights and sorts by
   399	    them on the same connection many times, with weight names spread wide enough that some of them
   400	    land on another shard in any multi-shard placement.
   401	    """
   402	    print("-- read-your-own-writes through BY/GET --")
   403	    if not one_executor:
   404	        print("  (skipped: dereference is not admitted in this configuration)")
   405	        return
   406	    elements = [str(i) for i in range(12)]
   407	    c.cmd("DEL", "s:ry")
   408	    c.cmd("RPUSH", "s:ry", *elements)
   409	    for round_index in range(40):
   410	        weights = {e: (round_index * 37 + int(e) * 11) % 97 for e in elements}
   411	        pairs = []
   412	        for e in elements:
   413	            pairs += ["s:ryw_%s_%d" % (e, round_index), str(weights[e])]
   414	            pairs += ["s:ryd_%s_%d" % (e, round_index), "v%s" % e]
   415	        c.cmd("MSET", *pairs)
   416	        want = sorted(elements, key=lambda e: (weights[e], e.encode("latin1")))
   417	        check("ryow round %d order" % round_index,
   418	              c.cmd("SORT", "s:ry", "BY", "s:ryw_*_%d" % round_index), want)
   419	        check("ryow round %d projection" % round_index,
   420	              c.cmd("SORT", "s:ry", "BY", "s:ryw_*_%d" % round_index,
   421	                    "GET", "s:ryd_*_%d" % round_index),
   422	              ["v%s" % e for e in want])
   423	        c.cmd("DEL", *[p for i, p in enumerate(pairs) if i % 2 == 0])
   424	
   425	
   426	def phase_multi_ryow(c, one_executor):
   427	    """The dereference inside a transaction.
   428	
   429	    REGRESSION PIN, and the battery's sharpest detector. EXEC does not serialise commands globally:
   430	    each shard walks only the commands it PARTICIPATES in, so commands over disjoint shards proceed
   431	    independently. A dereferencing SORT breaks that premise -- its participant set cannot name the
   432	    shards its patterns will read, because those are only known after the source has been read. Left
   433	    as an ordinary one-key Local child it ran before an earlier MSET had been applied on the weight
   434	    keys' shards and sorted by the PREVIOUS weights. `make sortnoctx` builds the binary in which the
   435	    fix is compiled out; every check below must fail against it.
   436	    """
   437	    print("-- dereference inside MULTI/EXEC --")
   438	    if not one_executor:
   439	        print("  (skipped: dereference is not admitted in this configuration)")
   440	        return
   441	    elements = [str(i) for i in range(10)]
   442	    for round_index in range(20):
   443	        c.cmd("DEL", "s:mr")
   444	        c.cmd("RPUSH", "s:mr", *elements)
   445	        weights = {e: (round_index * 53 + int(e) * 17) % 101 for e in elements}
   446	        setup = []
   447	        for e in elements:
   448	            setup += ["s:mrw_%s" % e, str((weights[e] + 500))]      # a stale value first
   449	            setup += ["s:mrd_%s" % e, "old%s" % e]
   450	        c.cmd("MSET", *setup)
   451	        pairs = []
   452	        for e in elements:
   453	            pairs += ["s:mrw_%s" % e, str(weights[e])]
   454	            pairs += ["s:mrd_%s" % e, "new%s" % e]
   455	        want = sorted(elements, key=lambda e: (weights[e], e.encode("latin1")))
   456	        check("multi ryow %d queue MSET" % round_index, c.cmd("MULTI"), "OK")
   457	        check("multi ryow %d queued" % round_index, c.cmd("MSET", *pairs), "QUEUED")
   458	        c.cmd("SORT", "s:mr", "BY", "s:mrw_*")
   459	        c.cmd("SORT", "s:mr", "BY", "s:mrw_*", "GET", "s:mrd_*")
   460	        c.cmd("SORT", "s:mr", "BY", "s:mrw_*", "STORE", "s:mrdst")
   461	        replies = c.cmd("EXEC")
   462	        check("multi ryow %d order" % round_index, replies[1], want)
   463	        check("multi ryow %d projection" % round_index, replies[2],
   464	              ["new%s" % e for e in want])
   465	        check("multi ryow %d stored" % round_index, c.cmd("LRANGE", "s:mrdst", "0", "-1"), want)
   466	
   467	
   468	def phase_random(c, one_executor, rng):
   469	    """Random weight sets checked against a Python model of the reference's rules."""
   470	    print("-- randomised model comparison --")
   471	    if not one_executor:
   472	        print("  (skipped: dereference is not admitted in this configuration)")
   473	        return
   474	    for trial in range(60):
   475	        n = rng.randint(1, 12)
   476	        elements = [str(rng.randint(0, 40)) for _ in range(n)]
   477	        elements = list(dict.fromkeys(elements))          # SORT of a list, distinct for clarity
   478	        c.cmd("DEL", "s:r")
   479	        c.cmd("RPUSH", "s:r", *elements)
   480	        weights = {}
   481	        for element in elements:
   482	            if rng.random() < 0.25:
   483	                continue                                   # missing -> NULL weight
   484	            weights[element] = rng.randint(-500, 500)
   485	            c.cmd("SET", "s:rw_" + element, str(weights[element]))
   486	        for element in elements:
   487	            if rng.random() < 0.3:
   488	                c.cmd("DEL", "s:rd_" + element)
   489	            else:
   490	                c.cmd("SET", "s:rd_" + element, "v" + element)
   491	        desc = rng.random() < 0.5
   492	        # Numeric ordering: a missing weight is zero, and equal weights fall back to a byte
   493	        # comparison of the ELEMENTS -- a total order, so the model is exact.
   494	        order = sorted(elements,
   495	                       key=lambda e: (weights.get(e, 0), e.encode("latin1")),
   496	                       reverse=desc)
   497	        args = ["SORT", "s:r", "BY", "s:rw_*"]
   498	        if desc:
   499	            args.append("DESC")
   500	        check("random %d order" % trial, c.cmd(*args), order)
   501	        args = ["SORT", "s:r", "BY", "s:rw_*"] + (["DESC"] if desc else []) + \
   502	               ["GET", "#", "GET", "s:rd_*"]
   503	        want = []
   504	        for element in order:
   505	            want.append(element)
   506	            got_key = c.cmd("EXISTS", "s:rd_" + element)
   507	            want.append("v" + element if got_key else None)
   508	        check("random %d projection" % trial, c.cmd(*args), want)
   509	        for element in elements:
   510	            c.cmd("DEL", "s:rw_" + element, "s:rd_" + element)
   511	
   512	
   513	def main():
   514	    rng = random.Random(SEED)
   515	    c = Conn()
   516	    n_ex = executors(c)
   517	    one_executor = n_ex == 1
   518	    print("sort battery: %s:%d, %d executor(s) -> dereference %s"
   519	          % (HOST, PORT, n_ex, "ADMITTED" if one_executor else "REFUSED"))
   520	    fixture(c)
   521	    phase_no_deref(c)
   522	    if one_executor:
   523	        phase_deref(c)
   524	    else:
   525	        phase_refused(c)
   526	    phase_set_determinism(c)
   527	    phase_scatter_arm(c, one_executor)
   528	    phase_ryow(c, one_executor)
   529	    phase_multi_ryow(c, one_executor)
   530	    phase_random(c, one_executor, rng)
   531	
   532	    # THE INVARIANT THAT MUST READ ZERO IN EVERY CONFIGURATION: no dereference ever reached a shard
   533	    # this executor does not own.
   534	    final = stats(c)
   535	    check("no foreign-shard dereference", final.get("sort_deref_escapes", -1), 0)
   536	    print("  counters: %s" % final)
   537	
   538	    c.cmd("FLUSHALL")
   539	    c.close()
   540	    print("\nsort: %d checks, %d failures -> %s"
   541	          % (checks, len(failures), "PASS" if not failures else "FAIL"))
   542	    for line in failures[:15]:
   543	        print("  " + line)
   544	    return 1 if failures else 0
   545	
   546	
   547	if __name__ == "__main__":
   548	    sys.exit(main())

diff --git a/NOTES-SORTXSHARD.md b/NOTES-SORTXSHARD.md
new file mode 100644
index 0000000000000000000000000000000000000000..274951e04c92f415609f27113c316da2c04a5fae
--- /dev/null
+++ b/NOTES-SORTXSHARD.md
@@ -0,0 +1,103 @@
+# Cross-owner SORT BY/GET notes
+
+## 2026-08-28: static trace and design checkpoint
+
+No part of this lane is already implemented.  The current multi-executor path still refuses every
+`*`-bearing BY/GET in `parse_sort_options`, and `sort_run` still calls `sort_lookup`, which reaches a
+second `Shard` directly.  That is legal only because admission currently proves one executor owns
+all shards.
+
+The existing seams are sufficient without changing the MVCC resolver or atomic record engine:
+
+1. `xshard_prepare` already forces an actually-dereferencing SORT off localfast.  Its phase-one
+   group contains only the source key (the STORE destination is deliberately omitted until hop 2).
+2. The source owner's task serializes one source `ObjectImage`.  This is the point at which the
+   natural-order element list becomes knowable.
+3. A SORT-only state object will be carved into the scatter arena.  Its vectors own the decoded
+   elements, concrete derived key/field requests, owner-grouped request order, and resolved values.
+   No state is added to `Op` or `Client`; the only new `ScatterState` member is a pointer at its cold
+   tail.
+4. Completion of the source wave expands every `*`-bearing BY and non-`#` GET pattern for every
+   source element.  Requests are bucketed by `router().shard_of(hash)` and posted as a second READ
+   wave.  Every task reads only the `FlatStore` of the `Shard&` passed to it.
+5. `xshard_execute` already installs `PinnedNowMs(state.now_cut_ms)` and a `ReadEpochGuard` from
+   `state.snapshot`/`origin_conn_id` for every owner task.  The derived wave will run under those
+   same two cuts as the source wave.  Dereferencing SORT must therefore pin a snapshot even when
+   the command has STORE and even at atomic mode 0.
+6. Once the last derived owner finishes, one executor calls the existing `sort_run` ordering core
+   with a resolved-value matrix.  Missing keys, wrong types, and absent hash fields leave the
+   corresponding presence bit clear.  `GET #` and globless patterns never create requests.  The
+   existing result/presence vectors then feed either the array reply or `sort_encode_store`.
+7. STORE continues through the existing phase-two `hop2[0]` plan and `apply_image_selected`, so the
+   destination is written only by its ordinary owner task.
+
+`sort_run` will remain the single implementation of ordering, LIMIT, DESC, NULL handling, and GET
+row construction.  The direct shard lookup will be removed; the core will consume optional
+parallel resolved BY/GET arrays instead.  Non-dereferencing forms pass no resolved matrix.
+
+### Wave/state details
+
+The ordinary `phase` byte remains 1 for both read waves and 2 for STORE apply.  A SORT-only wave enum
+in the arena sidecar distinguishes source/gather/resolved.  This avoids changing the generic
+two-hop mutation tests.  Before calling `finish_phase1`, derived groups are replaced with the
+original explicit-key groups so generic status/error scans never index the dynamic request order.
+
+Bare commands need a derived-wave publisher shaped like `publish_phase2`.  EXEC children do not
+post new tasks: all shards are already transaction participants, so the last source owner rebuilds
+the child groups, resets `pending`, and returns `PhaseAdvanced`; participant loops discover their
+new group on the next child stage.  The same happens once more for STORE apply.
+
+Task dependency/hazard enumeration must recognize the derived-wave key order instead of indexing
+the explicit argv-key array.  This is routing glue only.  The resolver, version selection, commit
+publication, and atomic apply machinery are unchanged.
+
+### Snapshot cut inside EXEC
+
+The parent transaction already pins one `SnapshotCut` when it contains a multi-owner read and stamps
+read-only xshard children from it before dispatch.  Dereferencing SORT must opt into that same path
+even with STORE: its read participant set is dynamic and may span owners although its initial source
+group has size one.  The child must borrow the parent's registered cut; it must not register its
+private scatter pool independently.
+
+### Required validation geometry (not run in this lane)
+
+This lane must never be validated with one executor.  The gate geometry is exactly:
+
+```
+--shards 16 --ratio 6:2 --enable-debug-command yes
+```
+
+The SORT battery will fail unless INFO reports 6 I/O and 2 executor threads and CONFIG reports 16
+shards.  Because the default placement assigns shard `sid` to executor slot `sid % 2`, it will walk
+candidate pattern prefixes, query `DEBUG SHARD` for the source and every concrete derived key, and
+require at least one derived key whose shard maps to the other executor slot.  It will print the
+source/derived shard pair and fail loudly if none is found.  STORE destinations will be selected by
+the same geometry search rather than assumed from a key spelling.
+
+Per lane rules, I have not built anything, run any test/load script, or started a server.
+
+## 2026-08-28: implementation checkpoint
+
+Implemented the planned owner-only waves:
+
+- `sort_run` no longer includes or reaches `Server`, `Shard`, `FlatStore`, or `KvObj`. It consumes
+  optional parallel resolved BY/GET arrays, so it remains the only ordering/LIMIT/projection core.
+- A `SortDerefState` object is carved after the ordinary scatter arrays. The only new
+  `ScatterState` member is its pointer at the cold tail. Concrete keys, fields, values, presence
+  bits, and dynamic key order live in that arena-owned object's vectors.
+- Source completion decodes the natural elements, expands concrete requests, and rebuilds the dense
+  shard groups. Each gather task promotes/resolves only keys in its own `Shard&`, under the existing
+  `ReadEpochGuard(state.snapshot, origin_conn_id)` and `PinnedNowMs(state.now_cut_ms)`.
+- The last gather task reduces into `ResultHeap`, restores the explicit source groups before generic
+  error/status scanning, and either finishes the reply or enters the unchanged STORE hop.
+- Bare SORT has a derived-wave publisher. EXEC uses the already-declared all-shard participant
+  barrier and advances the child stage twice (source to gather, then gather to STORE when present).
+- Dynamic request keys were added to task hazard/dependency enumeration; no generic explicit-key
+  index is used during the gather wave.
+- Dereferencing SORT now pins a snapshot even for STORE and atomic mode 0. In EXEC it causes the
+  parent transaction to register a cut and borrows that exact cut, including for STORE children.
+  No resolver/version/publication code was changed.
+- The multi-executor option refusals, `sort_deref_local`, and both denial constants were removed.
+
+Static inspection still pending: validation battery rewrite, stale negative-control cleanup,
+whole-tree symbol sweep, and final diff audit. No build or runtime check has been performed.
