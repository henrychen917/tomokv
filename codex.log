   879	bool execute_cross_command(Server& server, MultiExecState& state, MultiCommand& command,
   880	                           Shard& shard, uint32_t owner_thread_id, uint32_t stage) {
   881	    Op& op = *command.op;
   882	    const bool notify = (op.spec->flags & CmdFlags::NotifySelected) != 0;
   883	    if (notify)
   884	        notify_execute_source(shard, op, command.notify_order_base);
   885	    // MGET/EXISTS/TOUCH are the read kinds here and reach this function only with a key set that
   886	    // spans more than one shard, i.e. exactly the fan-out that could straddle. They resolve at the
   887	    // transaction's cut. MSET/MSETNX/DEL keep UINT64_MAX on purpose: their clone base must stay
   888	    // the newest committed value, or a read-modify-write inside EXEC would overwrite a concurrent
   889	    // commit from a stale image. Write visibility is deliberately untouched by this lane.
   890	    const bool read_kind = command.kind == MultiCommandKind::Mget ||
   891	                           command.kind == MultiCommandKind::Exists;
   892	    shard.store().atomic_set_read_context(
   893	        read_kind ? multi_read_cut(state) : UINT64_MAX, state.origin_conn_id);
   894	    if (command.kind == MultiCommandKind::Mget) {
   895	        for (size_t i = 0; i < command.key_args.size(); i++) {
   896	            if (command.key_shards[i] != shard.id()) continue;
   897	            const uint32_t arg = command.key_args[i];
   898	            const Slice key = op.arg(arg);
   899	            KvObj* object = notify ? shard.store_find<true>(FlatStore::hash_key(key), key)
   900	                                   : shard.store().find(FlatStore::hash_key(key), key);
   901	            if (!object || static_cast<Type>(object->type) != Type::String) continue;
   902	            MultiValue& value = command.values[i];
   903	            if (object->is_int()) {
   904	                char text[24];
   905	                const uint32_t n = i64_to_dec(text, object->int_value());
   906	                value.value.assign(text, n);
   907	            } else {
   908	                const Slice bytes = object->str_value();
   909	                value.value.assign(bytes.p, bytes.n);
   910	            }
   911	            value.present = true;
   912	        }
   913	    } else if (command.kind == MultiCommandKind::Mset ||
   914	               (command.kind == MultiCommandKind::Msetnx && stage == 1)) {
   915	        for (size_t i = 0; i < command.key_args.size(); i++) {
   916	            if (command.key_shards[i] != shard.id()) continue;
   917	            const uint32_t arg = command.key_args[i];
   918	            const Slice key = op.arg(arg);
   919	            const MultiPrepareWrite prepared = prepare_write_key(
   920	                server, state, shard, key, FlatStore::hash_key(key), owner_thread_id);
   921	            if (prepared == MultiPrepareWrite::Retry) {
   922	                shard.store().atomic_clear_read_epoch();
   923	                return false;
   924	            }
   925	            if (prepared == MultiPrepareWrite::Error) {
   926	                state.aborted.store(true, std::memory_order_release);
   927	                break;
   928	            }
   929	            const WorkError stored = store_xstring_selected(
   930	                notify, shard, key, FlatStore::hash_key(key), op.arg(arg + 1));
   931	            if (stored != WorkError::None) {
   932	                state.aborted.store(true, std::memory_order_release);
   933	                break;
   934	            }
   935	            if (notify) notify_record(shard, op, NOTIFY_STRING, NotifyEventId::Set, key);
   936	        }
   937	    } else if (command.kind == MultiCommandKind::Msetnx) {
   938	        for (size_t i = 0; i < command.key_args.size(); i++) {
   939	            if (command.key_shards[i] != shard.id()) continue;
   940	            const uint32_t arg = command.key_args[i];
   941	            const Slice key = op.arg(arg);
   942	            if (notify ? shard.store_find<true>(FlatStore::hash_key(key), key)
   943	                       : shard.store().find(FlatStore::hash_key(key), key))
   944	                command.condition_failed.store(true, std::memory_order_release);
   945	        }
   946	    } else if (command.kind == MultiCommandKind::Del) {
   947	        long long removed = 0;
   948	        for (size_t i = 0; i < command.key_args.size(); i++) {
   949	            if (command.key_shards[i] != shard.id()) continue;
   950	            const uint32_t arg = command.key_args[i];
   951	            const Slice key = op.arg(arg);
   952	            const MultiPrepareWrite prepared = prepare_write_key(
   953	                server, state, shard, key, FlatStore::hash_key(key), owner_thread_id);
   954	            if (prepared == MultiPrepareWrite::Retry) {
   955	                shard.store().atomic_clear_read_epoch();
   956	                return false;
   957	            }
   958	            if (prepared == MultiPrepareWrite::Error) {
   959	                state.aborted.store(true, std::memory_order_release);
   960	                break;
   961	            }
   962	            removed += notify ? shard.store_erase<true>(FlatStore::hash_key(key), key)
   963	                              : shard.store().erase(FlatStore::hash_key(key), key);
   964	        }
   965	        command.integer.fetch_add(removed, std::memory_order_relaxed);
   966	    } else if (command.kind == MultiCommandKind::Exists) {
   967	        long long found = 0;
   968	        for (size_t i = 0; i < command.key_args.size(); i++) {
   969	            if (command.key_shards[i] != shard.id()) continue;
   970	            const uint32_t arg = command.key_args[i];
   971	            const Slice key = op.arg(arg);
   972	            found += (notify ? shard.store_find<true>(FlatStore::hash_key(key), key)
   973	                             : shard.store().find(FlatStore::hash_key(key), key)) != nullptr;
   974	        }
   975	        command.integer.fetch_add(found, std::memory_order_relaxed);
   976	    }
   977	    shard.store().atomic_clear_read_epoch();
   978	    return true;
   979	}
