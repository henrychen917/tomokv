  1575	void assemble_mget(Client& client, Op& op, ScatterState& state, void* release_ctx,
  1576	                   void (*release_fn)(void*, int32_t, const char*),
  1577	                   void (*suppressed_fn)(void*)) {
  1578	    // MULTI assembles child replies on an executor, where no IO->owner release callback is
  1579	    // available. Copy a TLS child into its Op and leave the borrow descriptors in ScatterState;
  1580	    // multi_retire_entry returns them from the owning IO before destroying the state.
  1581	    if (client.is_tls() && !release_fn) {
  1582	        reply_array_header(op.sink(), state.key_count);
  1583	        for (uint32_t i = 0; i < state.key_count; i++) {
  1584	            const ValueSlot& slot = state.values[i];
  1585	            if (slot.kind == ValueKind::Nil) reply_null(op.sink(), op.resp3());
  1586	            else if (slot.kind == ValueKind::Inline)
  1587	                reply_bulk(op.sink(), Slice(slot.small, slot.len));
  1588	            else
  1589	                reply_bulk(op.sink(), Slice(slot.ptr, slot.len));
  1590	        }
  1560	    if (state.atomic_group) {
  1561	        if (!state.aof_group) return;
  1562	        ShardGroup* group = group_for(state, shard.id());
  1563	        if (!group || !group->count) return;
  1564	        AofProducer& producer = shard.store().aof();
  1565	        if (!producer.begin_group(state.aof_group)) return;
  1566	        bool ok = true;
  1567	        for (uint32_t i = 0; i < group->count; i++) {
  1568	            const uint32_t pos = state.key_order[group->begin + i];
  1569	            const KeyRef& key = state.keys[pos];
  1570	            ok &= state.atomic_pop
  1571	                ? producer.record_group_visible_post_image(
  1572	                      shard.store(), key.hash, op.arg(key.arg))
  1573	                : producer.record_group_post_image(
  1574	                      shard.store(), key.hash, op.arg(key.arg));
  1575	        }
  1576	        ok &= producer.finish_group();
  1577	        if (!ok) aof_abort_scatter_group(state);
  1578	        (void)context;
  1579	        return;
  1580	    }
  1581	    if (state.kind == Kind::AllShards) {
  1582	        if (op.cmd_name().eq_icase("flushdb") || op.cmd_name().eq_icase("flushall"))
  1583	            (void)shard.store().aof().record_flush();
  1584	        return;
  1585	    }
  1586	    if (state.kind == Kind::DebugReload || state.kind == Kind::DebugLoadAof ||
  1587	        state.kind == Kind::DbsizeExact ||
  1588	        state.kind == Kind::Keys) return;
  1589	    ShardGroup* group = group_for(state, shard.id());
  1590	    if (!group) return;
  1591	    for (uint32_t i = 0; i < group->count; i++) {
  1592	        const uint32_t pos = state.key_order[group->begin + i];
  1593	        const KeyRef& key = state.keys[pos];
  1594	        (void)shard.store().aof().record_post_image(
  1595	            shard.store(), key.hash, op.arg(key.arg), context);
  1596	    }
  1597	}
