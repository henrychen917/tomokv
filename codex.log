  1546	        case Kind::Copy:
  1547	        case Kind::Smove:
  1548	        case Kind::Sinterstore:
  1549	        case Kind::Sunionstore:
  1550	        case Kind::Sdiffstore:
  1551	        case Kind::Zunionstore:
  1552	        case Kind::Zinterstore:
  1553	        case Kind::Zdiffstore: state.final_reply = FinalReply::Integer; break;
  1554	        case Kind::Bitop: state.final_reply = FinalReply::Integer; break;
  1555	        case Kind::Pfmerge: state.final_reply = FinalReply::Ok; break;
  1556	        case Kind::Lmove:
  1557	        case Kind::Rpoplpush: state.final_reply = FinalReply::Bulk; break;
