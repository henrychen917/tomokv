    73	// ONE PUBLISHED READ CUT, whoever holds it.  A read that resolves its fragments on several owners
    74	// needs the versions its cut names to survive until the last fragment has answered, and the only
    75	// thing that keeps cleanup off them is the floor its owning IO thread publishes.  The floor slot is
    76	// per IO THREAD (Server::atomic_read_floors_), so exactly one object per thread may write it: that
    77	// thread's ScatterArenaPool.  Factoring the four bookkeeping fields out of ScatterState lets a
    78	// transaction (MultiExecState) hold a cut through the same pool and the same exact-minimum
    79	// arithmetic, instead of being locked out of the machinery because it carries a pool of its own.
    80	struct SnapshotCut {
    81	    uint64_t snapshot = UINT64_MAX;
    82	    uint32_t snapshot_slot = std::numeric_limits<uint32_t>::max();  // owning IO's unresolved set
    83	    bool snapshot_registered = false;
    84	    std::atomic<bool> snapshot_complete{false};
    85	};
    86	
    87	// The common arena size is deliberately a size class, not a maximum command size.  The owning IO
    88	// thread recycles these blocks after ROB retirement; larger shapes use exact-size heap blocks.
    89	// Keeping the freelist here (rather than in ScatterState) makes cross-thread frees impossible by
    90	// construction.
    91	class ScatterArenaPool {
    92	public:
    93	    ScatterArenaPool() = default;
    94	    ~ScatterArenaPool();
    95	    ScatterArenaPool(const ScatterArenaPool&) = delete;
    96	    ScatterArenaPool& operator=(const ScatterArenaPool&) = delete;
    97	
    98	private:
    99	    friend ScatterPrepare xshard_prepare(Server&, Op&, ScatterArenaPool&, uint32_t,
   100	                                          uint64_t, ScatterDispatch&, bool, Client*);
   101	    friend void xshard_destroy(ScatterState*, ScatterArenaPool&, uint32_t);
   102	    friend void xshard_retire(Server&, ThreadCtx&, Ring&, Client&, Op&, ScatterArenaPool&,
   103	                              uint32_t, void*, void (*)(void*, int32_t, const char*),
   104	                              void (*)(void*));
   105	    static constexpr uint32_t kCached = 64;
   106	    static constexpr size_t kCommonBytes = 16384;  // holds MGET-8 layouts at the 1KB inline slot
   107	    void* acquire(size_t bytes, bool& pooled);
   108	    void release(void* ptr, bool pooled);
   109	    void defer_destroy(ScatterState* state);
   110	public:
   111	    uint32_t reap_deferred();
   112	    uint32_t refresh_snapshot_floor(Server& server, uint32_t owner_io);
   113	    // `limit` is the per-IO-thread snapshot window; the script engine passes its own.
   114	    bool can_register_snapshot(uint32_t limit = 8) const;
   115	    // CALLER CONTRACT: both run on the IO thread that owns this pool, `owner_io` is that thread's
   116	    // id, and the bracket must enclose every fragment that resolves under the cut -- register
   117	    // before the tasks are posted, unregister only after the last one has answered.  register may
   118	    // advance cut->snapshot to a confirmed newer sequence (the hazard-pointer handshake), so read
   119	    // it back rather than reusing the value you asked for.
   120	    bool register_snapshot(Server& server, SnapshotCut* cut, uint32_t owner_io);
   121	    void unregister_snapshot(Server& server, SnapshotCut* cut, uint32_t owner_io);
   122	private:
   123	    void* cached_[kCached] = {};
   124	    uint32_t count_ = 0;
   125	    // Only unresolved cuts participate in the floor. Atomic work bounds this set at eight; in a
   126	    // read-only interval it is ROB-bounded instead, so the cached minimum/count below make insert
   127	    // and arbitrary removal O(1) without weakening the exact published floor.
   128	    std::vector<SnapshotCut*> unresolved_snapshots_;
   129	    std::vector<ScatterState*> deferred_destroy_;
   130	    uint64_t observed_snapshot_completions_ = 0;
   131	    uint64_t unresolved_snapshot_floor_ = UINT64_MAX;
   132	    uint32_t unresolved_floor_refs_ = 0;
   133	    uint64_t published_snapshot_floor_ = UINT64_MAX;
   134	};
