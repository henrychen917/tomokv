   332	def phase_scatter_arm(c, one_executor):
   333	    """The cross-shard engine arm: a STORE whose destination lands on another shard."""
   334	    print("-- cross-shard arm --")
   335	    before = stats(c)
   336	    names = ["s:sc%d" % i for i in range(12)]
   337	    for name in names:
   338	        if one_executor:
   339	            got = c.cmd("SORT", "s:L", "BY", "s:w_*", "GET", "s:d_*", "STORE", name)
   340	            check("scatter STORE %s" % name, got, 3)
   341	            check("scatter STORE %s contents" % name, c.cmd("LRANGE", name, "0", "-1"),
   342	                  ["three", "two", "one"])
   343	        else:
   344	            got = c.cmd("SORT", "s:L", "BY", "nosort", "GET", "#", "STORE", name)
   345	            check("scatter STORE %s" % name, got, 3)
   346	            check("scatter STORE %s contents" % name, c.cmd("LRANGE", name, "0", "-1"),
   347	                  ["3", "1", "2"])
   348	    after = stats(c)
   349	    fired = after["sort_scatter_general"] - before["sort_scatter_general"]
   350	    if fired <= 0:
   351	        failures.append("cross-shard SORT arm never ran (sort_scatter_general did not move)")
   352	        print("  FAIL cross-shard SORT arm never ran")
   353	    else:
   354	        print("  cross-shard arm ran %d times" % fired)
   355	    global checks
   356	    checks += 1
   357	
