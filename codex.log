   327	bool multi_sort_dereferences(const MultiQueuedCommand& queued) {
   328	    if (!has_name(queued, "sort") && !has_name(queued, "sort_ro")) return false;
   329	    const uint32_t argc = static_cast<uint32_t>(queued.argv.size());
   330	    for (uint32_t i = 2; i < argc; i++) {
   331	        const Slice word(queued.argv[i].data(), static_cast<uint32_t>(queued.argv[i].size()));
   332	        // Mirror parse_sort_options' grammar so an option word appearing INSIDE a pattern is not
   333	        // mistaken for the option itself.
   334	        if (word.eq_icase("limit") && i + 2 < argc) { i += 2; continue; }
   335	        if (!(word.eq_icase("by") || word.eq_icase("get")) || i + 1 >= argc) continue;
   336	        const std::string& pattern = queued.argv[++i];
   337	        // `#` is the element and a pattern with no '*' is a constant nil: neither reads a key.
   338	        const bool self = word.eq_icase("get") && pattern.size() == 1 && pattern[0] == '#';
