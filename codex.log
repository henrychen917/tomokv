   224	def phase_deref(c):
   225	    print("-- single executor: the full BY/GET surface --")
   226	    before = stats(c)
   227	
   228	    # substitution is the FIRST '*' only, and a backslash escapes nothing.
   229	    check("first '*' only", c.cmd("SORT", "s:L", "BY", "s:a*b*c"), ["1", "2", "3"])
   230	    check("substituted key found", c.cmd("SORT", "s:L", "BY", "s:a*b", "ALPHA"), ["3", "2", "1"])
   231	    check("backslash is an ordinary byte", c.cmd("SORT", "s:L", "BY", "s:w\\*x"), ["3", "2", "1"])
   232	    check("plain substitution", c.cmd("SORT", "s:L", "BY", "s:w*x"), ["3", "1", "2"])
   233	
   234	    # "->" is a field separator only AFTER the '*' and only with a non-empty tail.
   235	    check("hash field weight", c.cmd("SORT", "s:L", "BY", "s:h_*->f"), ["3", "2", "1"])
   236	    check_err("empty field is key bytes", c.cmd("SORT", "s:L", "BY", "s:h_*->"),
   237	              "ERR One or more scores can't be converted into double")
   238	    check("'->' before the '*' is key bytes", c.cmd("SORT", "s:L", "BY", "s:x->f*"),
   239	          ["2", "3", "1"])
   240	
   241	    # NULL weights: missing key, wrong-type key, or a hash without the field.
   242	    check("all weights null, numeric", c.cmd("SORT", "s:L", "BY", "s:none_*"), ["1", "2", "3"])
   243	    check("all weights null, alpha", c.cmd("SORT", "s:L", "BY", "s:none_*", "ALPHA"),
   244	          ["3", "1", "2"])
   245	    check("one weight present, numeric", c.cmd("SORT", "s:L", "BY", "s:p_*"), ["1", "3", "2"])
   246	    check("null sorts before present, alpha",
   247	          c.cmd("SORT", "s:L", "BY", "s:p_*", "ALPHA"), ["3", "1", "2"])
   248	    check("desc keeps ties in input order",
   249	          c.cmd("SORT", "s:L", "BY", "s:p_*", "ALPHA", "DESC"), ["2", "3", "1"])
   250	    check("hash without a field is null", c.cmd("SORT", "s:L", "BY", "s:h_*"), ["1", "2", "3"])
   251	    check("collection weight is null", c.cmd("SORT", "s:L", "BY", "s:L*"), ["1", "2", "3"])
   252	
   253	    # A PRESENT non-numeric weight is the error; an ABSENT one is zero.
   254	    check_err("non-numeric weight errors", c.cmd("SORT", "s:L", "BY", "s:nn_*"),
   255	              "ERR One or more scores can't be converted into double")
   256	    check_err("...even under LIMIT", c.cmd("SORT", "s:L", "BY", "s:nn_*", "LIMIT", "0", "1"),
   257	              "ERR One or more scores can't be converted into double")
   258	    check("...but ALPHA accepts it", c.cmd("SORT", "s:L", "BY", "s:nn_*", "ALPHA"),
   259	          ["2", "3", "1"])
   260	
   261	    # GET projection.
   262	    check("GET string pattern", c.cmd("SORT", "s:L", "BY", "s:w_*", "GET", "s:d_*"),
   263	          ["three", "two", "one"])
   264	    check("GET # with BY", c.cmd("SORT", "s:L", "BY", "s:w_*", "GET", "#"), ["3", "2", "1"])
   265	    check("interleaved GETs",
   266	          c.cmd("SORT", "s:L", "BY", "s:w_*", "GET", "#", "GET", "s:d_*", "GET", "s:h_*->g"),
   267	          ["3", "three", "C", "2", "two", "B", "1", "one", "A"])
   268	    check("GET on missing keys", c.cmd("SORT", "s:L", "GET", "s:nope_*"), [None, None, None])
   269	    check("GET on a hash without a field", c.cmd("SORT", "s:L", "GET", "s:h_*"),
   270	          [None, None, None])
   271	    check("GET hash field, alpha", c.cmd("SORT", "s:L", "GET", "s:h_*->g", "ALPHA"),
   272	          ["A", "B", "C"])
   273	    check("dontsort keeps list order under GET",
   274	          c.cmd("SORT", "s:L", "BY", "nosort", "GET", "#", "GET", "s:d_*"),
   275	          ["3", "three", "1", "one", "2", "two"])
   276	
   277	    # STORE of a projection, and the empty-result deletion.
   278	    check("STORE a projection",
   279	          c.cmd("SORT", "s:L", "BY", "s:w_*", "GET", "s:d_*", "STORE", "s:dst"), 3)
   280	    check("stored projection", c.cmd("LRANGE", "s:dst", "0", "-1"), ["three", "two", "one"])
   281	    check("stored type", c.cmd("TYPE", "s:dst"), "list")
   282	    check("nulls store as empty elements",
   283	          c.cmd("SORT", "s:L", "GET", "s:nope_*", "STORE", "s:dst2"), 3)
   284	    check("stored nulls", c.cmd("LRANGE", "s:dst2", "0", "-1"), ["", "", ""])
   285	    c.cmd("SET", "s:keep", "v")
   286	    check("empty result returns 0", c.cmd("SORT", "s:none", "BY", "s:w_*", "STORE", "s:keep"), 0)
   287	    check("empty result deletes the destination", c.cmd("EXISTS", "s:keep"), 0)
   288	    check("missing source with BY/GET", c.cmd("SORT", "s:none", "BY", "s:w_*", "GET", "s:d_*"),
   289	          [])
   290	    check("SORT_RO dereferences", c.cmd("SORT_RO", "s:L", "BY", "s:w_*", "GET", "s:d_*"),
   291	          ["three", "two", "one"])
   292	    check_err("SORT_RO still refuses STORE",
   293	              c.cmd("SORT_RO", "s:L", "BY", "s:w_*", "STORE", "s:x"), "ERR syntax error")
   294	    check_err("last BY wins", c.cmd("SORT", "s:L", "BY", "s:w_*", "GET", "#", "BY", "s:nn_*"),
   295	              "ERR One or more scores can't be converted into double")
   296	
   297	    after = stats(c)
   298	    # MECHANISM CONTROL: this phase must have read derived keys, and refused nothing.
   299	    if after["sort_deref_lookups"] - before["sort_deref_lookups"] <= 0:
   300	        failures.append("deref phase performed no lookups at all")
   301	        print("  FAIL deref phase performed no lookups at all")
   302	    check("deref phase refused nothing",
   303	          after["sort_deref_refusals"] - before["sort_deref_refusals"], 0)
