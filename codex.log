   211	def phase_no_deref(c):
   212	    """Forms that read no derived key at all. These must behave identically in EVERY config."""
   213	    print("-- forms that dereference nothing --")
   214	    before = stats(c)
   215	    check("BY globless suppresses ordering", c.cmd("SORT", "s:L", "BY", "nosort"),
   216	          ["3", "1", "2"])
   217	    check("BY globless, other spelling", c.cmd("SORT", "s:L", "BY", "constant"),
   218	          ["3", "1", "2"])
   219	    # '?' and '[' are glob metacharacters but NOT substitution points: only '*' is.
   220	    check("BY '?' is not a substitution", c.cmd("SORT", "s:L", "BY", "?_w"), ["3", "1", "2"])
   221	    check("BY '[' is not a substitution", c.cmd("SORT", "s:L", "BY", "[ab]_w"), ["3", "1", "2"])
   222	    check("BY globless + DESC reverses a list",
   223	          c.cmd("SORT", "s:L", "BY", "nosort", "DESC"), ["2", "1", "3"])
   224	    check("BY globless + DESC reverses a zset",
   225	          c.cmd("SORT", "s:Z", "BY", "nosort", "DESC"), ["a", "c", "b"])
   226	    check("BY globless + LIMIT", c.cmd("SORT", "s:L", "BY", "nosort", "LIMIT", "1", "1"), ["1"])
   227	    check("BY globless + LIMIT past the end",
   228	          c.cmd("SORT", "s:L", "BY", "nosort", "LIMIT", "5", "5"), [])
   229	    check("BY globless + negative offset clamps",
   230	          c.cmd("SORT", "s:L", "BY", "nosort", "LIMIT", "-1", "2"), ["3", "1"])
   231	    check("GET # is the element", c.cmd("SORT", "s:L", "GET", "#"), ["1", "2", "3"])
   232	    check("GET # twice", c.cmd("SORT", "s:L", "GET", "#", "GET", "#"),
   233	          ["1", "1", "2", "2", "3", "3"])
   234	    check("BY globless + GET #", c.cmd("SORT", "s:L", "BY", "nosort", "GET", "#"),
   235	          ["3", "1", "2"])
   236	    # A GET pattern with no '*' never looks a key up; the reference answers a null per element.
   237	    check("GET globless is a constant null", c.cmd("SORT", "s:L", "GET", "literal"),
   238	          [None, None, None])
   239	    check("GET '##' is not the element", c.cmd("SORT", "s:L", "GET", "##"), [None, None, None])
   240	    check("BY globless + STORE", c.cmd("SORT", "s:L", "BY", "nosort", "STORE", "s:dl"), 3)
   241	    check("BY globless + STORE contents", c.cmd("LRANGE", "s:dl", "0", "-1"), ["3", "1", "2"])
   242	    check("GET null stores an empty element",
   243	          c.cmd("SORT", "s:L", "GET", "literal", "GET", "#", "STORE", "s:dm"), 6)
   244	    check("GET null STORE contents", c.cmd("LRANGE", "s:dm", "0", "-1"),
   245	          ["", "1", "", "2", "", "3"])
   246	    check("missing source with BY globless", c.cmd("SORT", "s:none", "BY", "nosort"), [])
   247	    check_err("wrong type source", c.cmd("SORT", "s:h_1", "BY", "nosort"), "WRONGTYPE")
   248	    check_err("syntax error precedes a later BY",
   249	              c.cmd("SORT", "s:L", "BADTOKEN", "BY", "s:w_*"), "ERR syntax error")
   250	    check_err("BY needs an argument", c.cmd("SORT", "s:L", "BY"), "ERR syntax error")
   251	    check_err("GET needs an argument", c.cmd("SORT", "s:L", "GET"), "ERR syntax error")
   252	    after = stats(c)
   253	    # MECHANISM CONTROL: not one of the forms above may read a derived key.
   254	    check("no-deref phase performed no lookups",
   255	          after["sort_deref_lookups"] - before["sort_deref_lookups"], 0)
