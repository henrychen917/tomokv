   481	def main():
   482	    rng = random.Random(SEED)
   483	    c = Conn()
   484	    n_ex = executors(c)
   485	    one_executor = n_ex == 1
   486	    print("sort battery: %s:%d, %d executor(s) -> dereference %s"
   487	          % (HOST, PORT, n_ex, "ADMITTED" if one_executor else "REFUSED"))
   488	    fixture(c)
   489	    phase_no_deref(c)
   490	    if one_executor:
   491	        phase_deref(c)
