   801	bool xshard_plain_prepare(Server& server, Shard& shard, Op& op, uint64_t origin_conn_id) {
   802	    FlatStore& store = shard.store();
   803	    if (!store.atomic_has_records()) return true;
   804	    const uint32_t read_stall = server.debug_atomic_read_delay();
   805	    if (__builtin_expect(read_stall != 0, false) &&
   806	        !(op.spec->flags & (CmdFlags::Write | CmdFlags::SnapshotWrite)))
   807	        Server::debug_stall_us(read_stall);
   808	    const uint64_t cleanup_cutoff = server.atomic_snapshot();
   809	    const uint64_t floor = server.atomic_read_floor();
   810	    if (op.local_xshard()) {
   811	        struct RecordedKey { uint64_t hash; Slice key; };
   812	        std::vector<RecordedKey> recorded;
   813	        bool allocation_failed = false;
   814	        for_each_touched_key(op, [&](uint64_t hash, Slice key) {
   815	            if (allocation_failed) return;
   816	            store.atomic_promote_key(hash, key, floor, cleanup_cutoff);
   817	            if (!store.atomic_needs_version(hash, key)) return;
   818	            if (!store.atomic_has_record(hash, key) &&
   819	                (op.spec->flags & (CmdFlags::Write | CmdFlags::SnapshotWrite)))
   820	                server.note_script_forced_write();
  2060	    if (!has_watches()) return true;
  2061	    std::vector<std::string> keys;
  2062	    try {
  2063	        keys.reserve(watch_reservations_.size());
  2064	        for (const auto& item : watch_reservations_) keys.push_back(item.first);
  2065	    } catch (const std::bad_alloc&) {
  2066	        return false;
  2067	    }
  2068	    for (const std::string& key : keys)
  2069	        if (!watch_finalize_reservation(key)) return false;
  2070	    return true;
  2071	}
