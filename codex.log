   729	template <typename Fn>
   730	bool for_each_task_key(const Task& task, Op& op, int32_t shard_id, Fn&& fn) {
   731	    if (task.scatter) {
   732	        ScatterState& state = *task.scatter;
   733	        // WHOLE-OWNER COMMANDS NAME NO KEYS, AND THAT IS THE POINT. KEYS, exact DBSIZE and
   734	        // FLUSHDB/FLUSHALL carry a zero-key ShardGroup for EVERY shard, so group_for() succeeds
   735	        // and the old `!group` test below never produced the whole-owner answer for them. They
   736	        // therefore reported "touches nothing", xshard_tasks_share_key() found no overlap, and
   737	        // has_atomic_deferred_predecessor() let a younger walker run past an older
   738	        // same-connection group still parked in atomic_deferred_ (a direct RENAME's destination
   739	        // task waiting on direct_ready is the common case). The walker's bounded cursor then
   740	        // swept the destination slot before the install landed and the key was silently absent
   741	        // from a listing whose own RENAME had already answered +OK. A zero-key group logically
   742	        // touches every key this owner holds, so it overlaps every other task on this shard.
   743	        //
   744	        // Scoped to THIS task's own shard on purpose. A whole-owner command carries a group for
   745	        // every shard, so answering "touches everything" for a shard the parked task is not
   746	        // executing on would make one parked walker hold every younger task on every other shard
   747	        // its executor owns -- which livelocked the xshard differ at ~1/20 (a walker parked on an
   748	        // undecided entry stalled the very groups whose completion would decide it).
   749	        if (state.key_count == 0)
   750	            return (task.shard >= 0 ? task.shard : op.shard) == shard_id;
   751	        ShardGroup* group = group_for(state, shard_id);
   752	        if (!group) return false;
   753	        for (uint32_t i = 0; i < group->count; i++) {
   754	            const uint32_t pos = state.key_order[group->begin + i];
   755	            const KeyRef& key = state.keys[pos];
   756	            fn(key.hash, op.arg(key.arg));
   757	        }
   758	        return false;
   759	    }
   760	    if (op.local_xshard()) {
   761	        for_each_touched_key(op, std::forward<Fn>(fn));
   762	    } else {
   763	        fn(op.hash, op_routed_key(op));
   764	    }
   765	    return false;
   766	}
