   947	}  // namespace
   948	
   949	ScatterArenaPool::~ScatterArenaPool() {
   950	    reap_deferred();
   951	    for (uint32_t i = 0; i < count_; i++) std::free(cached_[i]);
   952	}
   953	
   954	void* ScatterArenaPool::acquire(size_t bytes, bool& pooled) {
   955	    pooled = bytes <= kCommonBytes;
   956	    if (pooled && count_) return cached_[--count_];
   957	    void* memory = nullptr;
   958	    if (::posix_memalign(&memory, alignof(OwnerRecordRefs), pooled ? kCommonBytes : bytes) != 0)
   959	        return nullptr;
   960	    return memory;
   961	}
   962	
   963	void ScatterArenaPool::release(void* ptr, bool pooled) {
   964	    if (!ptr) return;
   965	    if (pooled && count_ < kCached) cached_[count_++] = ptr;
   966	    else std::free(ptr);
   967	}
   968	
   969	ScatterPrepare xshard_prepare(Server& server, Op& op, ScatterArenaPool& pool,
   970	                              uint32_t owner_io, uint64_t origin_conn_id,
   971	                              ScatterDispatch& dispatch, bool force_atomic,
   972	                              Client* origin_client) {
   973	    const bool all_shards = (op.spec->flags & CmdFlags::AllShards) ||
   974	                            ((op.spec->flags & CmdFlags::ConfigRoute) &&
   975	                             command_config_routes_all_shards(op));
   976	    Kind kind;
   977	    if (all_shards)
   978	        kind = op.cmd_name().eq_icase("dbsize") ? Kind::DbsizeExact :
   979	               op.cmd_name().eq_icase("debug") && op.arg(1).eq_icase("loadaof")
   980	                   ? Kind::DebugLoadAof :
   981	               op.cmd_name().eq_icase("debug") ? Kind::DebugReload : Kind::AllShards;
   982	    else if (!(op.spec->flags & CmdFlags::MultiShard) || !classify(op, kind))
   983	        return ScatterPrepare::NotScatter;
