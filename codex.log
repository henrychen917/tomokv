   394	def phase_multi_ryow(c, one_executor):
   395	    """The dereference inside a transaction.
   396	
   397	    REGRESSION PIN, and the battery's sharpest detector. EXEC does not serialise commands globally:
   398	    each shard walks only the commands it PARTICIPATES in, so commands over disjoint shards proceed
   399	    independently. A dereferencing SORT breaks that premise -- its participant set cannot name the
   400	    shards its patterns will read, because those are only known after the source has been read. Left
   401	    as an ordinary one-key Local child it ran before an earlier MSET had been applied on the weight
   402	    keys' shards and sorted by the PREVIOUS weights. `make sortnoctx` builds the binary in which the
   403	    fix is compiled out; every check below must fail against it.
   404	    """
   405	    print("-- dereference inside MULTI/EXEC --")
   406	    if not one_executor:
   407	        print("  (skipped: dereference is not admitted in this configuration)")
   408	        return
   409	    elements = [str(i) for i in range(10)]
   410	    for round_index in range(20):
   411	        c.cmd("DEL", "s:mr")
   412	        c.cmd("RPUSH", "s:mr", *elements)
   413	        weights = {e: (round_index * 53 + int(e) * 17) % 101 for e in elements}
   414	        setup = []
   415	        for e in elements:
   416	            setup += ["s:mrw_%s" % e, str((weights[e] + 500))]      # a stale value first
   417	            setup += ["s:mrd_%s" % e, "old%s" % e]
   418	        c.cmd("MSET", *setup)
   419	        pairs = []
   420	        for e in elements:
   421	            pairs += ["s:mrw_%s" % e, str(weights[e])]
   422	            pairs += ["s:mrd_%s" % e, "new%s" % e]
   423	        want = sorted(elements, key=lambda e: (weights[e], e.encode("latin1")))
   424	        check("multi ryow %d queue MSET" % round_index, c.cmd("MULTI"), "OK")
   425	        check("multi ryow %d queued" % round_index, c.cmd("MSET", *pairs), "QUEUED")
   426	        c.cmd("SORT", "s:mr", "BY", "s:mrw_*")
   427	        c.cmd("SORT", "s:mr", "BY", "s:mrw_*", "GET", "s:mrd_*")
   428	        c.cmd("SORT", "s:mr", "BY", "s:mrw_*", "STORE", "s:mrdst")
   429	        replies = c.cmd("EXEC")
   430	        check("multi ryow %d order" % round_index, replies[1], want)
   431	        check("multi ryow %d projection" % round_index, replies[2],
   432	              ["new%s" % e for e in want])
   433	        check("multi ryow %d stored" % round_index, c.cmd("LRANGE", "s:mrdst", "0", "-1"), want)
   434	
