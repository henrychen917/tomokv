   493	        phase_refused(c)
   494	    phase_set_determinism(c)
   495	    phase_scatter_arm(c, one_executor)
   496	    phase_ryow(c, one_executor)
   497	    phase_multi_ryow(c, one_executor)
   498	    phase_random(c, one_executor, rng)
   499	
   500	    # THE INVARIANT THAT MUST READ ZERO IN EVERY CONFIGURATION: no dereference ever reached a shard
   501	    # this executor does not own.
   502	    final = stats(c)
   503	    check("no foreign-shard dereference", final.get("sort_deref_escapes", -1), 0)
   504	    print("  counters: %s" % final)
