  1013	            if (watched.shard != shard.id()) continue;
  1014	            const Slice key(watched.key.data(), static_cast<uint32_t>(watched.key.size()));
  1015	            if (!shard.watch_add(key, state.client, state.watch_generation)) return false;
  1016	        }
  1017	    } else if (state.kind == MultiStateKind::Execute) {
  1018	        for (const MultiWatchedKey& watched : state.watched) {
