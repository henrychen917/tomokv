   774	bool xshard_tasks_share_key(const Task& older, Op& older_op,
   775	                            const Task& younger, Op& younger_op, int32_t shard_id) {
   776	    if (!older.client || older.client != younger.client || older.op_id >= younger.op_id)
   777	        return false;
   778	    bool overlap = false;
   779	    const bool older_all = for_each_task_key(older, older_op, shard_id,
   780	        [&](uint64_t older_hash, Slice older_key) {
   781	            const bool younger_all = for_each_task_key(younger, younger_op, shard_id,
   782	                [&](uint64_t younger_hash, Slice younger_key) {
   783	                    overlap |= older_hash == younger_hash && older_key == younger_key;
   784	                });
   785	            overlap |= younger_all;
   786	        });
   787	    return overlap || older_all;
   788	}
