+enum class SortDerefWave : uint8_t { Source, Gather, Resolved };
+
+struct SortDerefRequest {
+    std::string key;
+    std::string field;
+    std::string value;
+    uint64_t hash = 0;
+    size_t output = 0;
+    int32_t shard = -1;
+    bool by = false;
+    bool present = false;
