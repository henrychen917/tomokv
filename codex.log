   577	bool first_error(const ScatterState& state, WorkError& error) {
   578	    for (uint32_t gi = 0; gi < state.nsub; gi++) {
   579	        const ShardGroup& group = state.groups[gi];
   580	        if (group.error != WorkError::None) { error = group.error; return true; }
   581	        if (!state.status || !(state.kind == Kind::Mset || state.kind == Kind::Pfcount ||
   582	                               state.kind == Kind::Xread || state.kind == Kind::Lcs ||
   583	                               is_two_hop(state.kind))) continue;
   584	        for (uint32_t i = 0; i < group.count; i++) {
   585	            const WorkError value = static_cast<WorkError>(state.status[state.key_order[group.begin + i]]);
   586	            if (value != WorkError::None) { error = value; return true; }
   587	        }
   588	    }
   589	    return false;
   590	}
   591	
   592	uint32_t key_count_for(Kind kind, const Op& op, uint32_t sinter_count,
   593	                       uint32_t mpop_count, bool sort_store, uint32_t xread_count = 0,
   594	                       uint32_t zset_count = 0, bool geo_store = false) {
   595	    if (kind == Kind::AllShards || kind == Kind::DebugReload || kind == Kind::DebugLoadAof ||
   596	        kind == Kind::DbsizeExact || kind == Kind::Keys) return 0;
   597	    if (kind == Kind::Mset || kind == Kind::Msetnx) return (op.argc() - 1) / 2;
   598	    if (kind == Kind::Bitop) return op.argc() - 2;
   599	    if (kind == Kind::Rename || kind == Kind::Renamenx || kind == Kind::Copy ||
   600	        kind == Kind::Smove || kind == Kind::Lmove || kind == Kind::Rpoplpush) return 2;
   601	    if (kind == Kind::Sintercard) return sinter_count;
   602	    if (is_any_zsetop(kind)) return zset_count + (is_store_zsetop(kind) ? 1 : 0);
   603	    if (is_geo_kind(kind)) return geo_store ? 2 : 1;
   604	    if (kind == Kind::Lmpop || kind == Kind::Zmpop) return mpop_count;
   605	    if (kind == Kind::Zrangestore) return 2;
   606	    if (kind == Kind::Lcs) return 2;
   607	    if (kind == Kind::Sort) return sort_store ? 2 : 1;
   608	    if (kind == Kind::Xread || kind == Kind::Xreadgroup) return xread_count;
   609	    if (kind == Kind::Script) {
   610	        uint32_t first = 0, count = 0;
