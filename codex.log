   258	def phase_deref(c):
   259	    print("-- full BY/GET surface across owners --")
   260	    before = stats(c)
   261	
   262	    # substitution is the FIRST '*' only, and a backslash escapes nothing.
   263	    check("first '*' only", c.cmd("SORT", "s:L", "BY", "s:a*b*c"), ["1", "2", "3"])
   264	    check("substituted key found", c.cmd("SORT", "s:L", "BY", "s:a*b", "ALPHA"), ["3", "2", "1"])
   265	    check("backslash is an ordinary byte", c.cmd("SORT", "s:L", "BY", "s:w\\*x"), ["3", "2", "1"])
   266	    check("plain substitution", c.cmd("SORT", "s:L", "BY", "s:w*x"), ["3", "1", "2"])
   267	
   268	    # "->" is a field separator only AFTER the '*' and only with a non-empty tail.
   269	    check("hash field weight", c.cmd("SORT", "s:L", "BY", "s:h_*->f"), ["3", "2", "1"])
   270	    check_err("empty field is key bytes", c.cmd("SORT", "s:L", "BY", "s:h_*->"),
   271	              "ERR One or more scores can't be converted into double")
   272	    check("'->' before the '*' is key bytes", c.cmd("SORT", "s:L", "BY", "s:x->f*"),
   273	          ["2", "3", "1"])
   274	
   275	    # NULL weights: missing key, wrong-type key, or a hash without the field.
   276	    check("all weights null, numeric", c.cmd("SORT", "s:L", "BY", "s:none_*"), ["1", "2", "3"])
   277	    check("all weights null, alpha", c.cmd("SORT", "s:L", "BY", "s:none_*", "ALPHA"),
   278	          ["3", "1", "2"])
   279	    check("one weight present, numeric", c.cmd("SORT", "s:L", "BY", "s:p_*"), ["1", "3", "2"])
   280	    check("null sorts before present, alpha",
   281	          c.cmd("SORT", "s:L", "BY", "s:p_*", "ALPHA"), ["3", "1", "2"])
   282	    check("desc keeps ties in input order",
   283	          c.cmd("SORT", "s:L", "BY", "s:p_*", "ALPHA", "DESC"), ["2", "3", "1"])
   284	    check("hash without a field is null", c.cmd("SORT", "s:L", "BY", "s:h_*"), ["1", "2", "3"])
   285	    check("collection weight is null", c.cmd("SORT", "s:L", "BY", "s:L*"), ["1", "2", "3"])
   286	
   287	    # A PRESENT non-numeric weight is the error; an ABSENT one is zero.
   288	    check_err("non-numeric weight errors", c.cmd("SORT", "s:L", "BY", "s:nn_*"),
   289	              "ERR One or more scores can't be converted into double")
   290	    check_err("...even under LIMIT", c.cmd("SORT", "s:L", "BY", "s:nn_*", "LIMIT", "0", "1"),
   291	              "ERR One or more scores can't be converted into double")
   292	    check("...but ALPHA accepts it", c.cmd("SORT", "s:L", "BY", "s:nn_*", "ALPHA"),
   293	          ["2", "3", "1"])
   294	
   295	    # GET projection.
   296	    check("GET string pattern", c.cmd("SORT", "s:L", "BY", "s:w_*", "GET", "s:d_*"),
   297	          ["three", "two", "one"])
   298	    check("GET # with BY", c.cmd("SORT", "s:L", "BY", "s:w_*", "GET", "#"), ["3", "2", "1"])
   299	    check("interleaved GETs",
   300	          c.cmd("SORT", "s:L", "BY", "s:w_*", "GET", "#", "GET", "s:d_*", "GET", "s:h_*->g"),
   301	          ["3", "three", "C", "2", "two", "B", "1", "one", "A"])
   302	    check("GET on missing keys", c.cmd("SORT", "s:L", "GET", "s:nope_*"), [None, None, None])
   303	    check("GET on a hash without a field", c.cmd("SORT", "s:L", "GET", "s:h_*"),
   304	          [None, None, None])
   305	    check("GET hash field, alpha", c.cmd("SORT", "s:L", "GET", "s:h_*->g", "ALPHA"),
   306	          ["A", "B", "C"])
   307	    check("dontsort keeps list order under GET",
   308	          c.cmd("SORT", "s:L", "BY", "nosort", "GET", "#", "GET", "s:d_*"),
   309	          ["3", "three", "1", "one", "2", "two"])
   310	
   311	    # STORE of a projection, and the empty-result deletion.
   312	    check("STORE a projection",
   313	          c.cmd("SORT", "s:L", "BY", "s:w_*", "GET", "s:d_*", "STORE", "s:dst"), 3)
   314	    check("stored projection", c.cmd("LRANGE", "s:dst", "0", "-1"), ["three", "two", "one"])
   315	    check("stored type", c.cmd("TYPE", "s:dst"), "list")
   316	    check("nulls store as empty elements",
   317	          c.cmd("SORT", "s:L", "GET", "s:nope_*", "STORE", "s:dst2"), 3)
   318	    check("stored nulls", c.cmd("LRANGE", "s:dst2", "0", "-1"), ["", "", ""])
   319	    c.cmd("SET", "s:keep", "v")
   320	    check("empty result returns 0", c.cmd("SORT", "s:none", "BY", "s:w_*", "STORE", "s:keep"), 0)
   321	    check("empty result deletes the destination", c.cmd("EXISTS", "s:keep"), 0)
   322	    check("missing source with BY/GET", c.cmd("SORT", "s:none", "BY", "s:w_*", "GET", "s:d_*"),
   323	          [])
   324	    check("SORT_RO dereferences", c.cmd("SORT_RO", "s:L", "BY", "s:w_*", "GET", "s:d_*"),
   325	          ["three", "two", "one"])
   326	    check_err("SORT_RO still refuses STORE",
   327	              c.cmd("SORT_RO", "s:L", "BY", "s:w_*", "STORE", "s:x"), "ERR syntax error")
   328	    check_err("last BY wins", c.cmd("SORT", "s:L", "BY", "s:w_*", "GET", "#", "BY", "s:nn_*"),
   329	              "ERR One or more scores can't be converted into double")
   330	
   331	    after = stats(c)
   332	    # MECHANISM CONTROL: this phase must have read derived keys.
   333	    if after["sort_deref_lookups"] - before["sort_deref_lookups"] <= 0:
   334	        failures.append("deref phase performed no lookups at all")
   335	        print("  FAIL deref phase performed no lookups at all")
