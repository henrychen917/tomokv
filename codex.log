   306	def phase_set_determinism(c):
   307	    """A set has no order, so a STOREd dontsort must not be allowed to be unordered."""
   308	    print("-- set/STORE determinism rule --")
   309	    members = ["delta", "alpha", "charlie", "bravo", "echo"]
   310	    c.cmd("DEL", "s:HS")
   311	    c.cmd("SADD", "s:HS", *members)
   312	    unordered = c.cmd("SORT", "s:HS", "BY", "nosort")
   313	    check("dontsort on a set returns the whole set", sorted(unordered), sorted(members))
   314	    check("dontsort + STORE forces an alphabetic order",
   315	          c.cmd("SORT", "s:HS", "BY", "nosort", "STORE", "s:ds"), 5)
   316	    check("stored set order", c.cmd("LRANGE", "s:ds", "0", "-1"), sorted(members))
   317	    check("dontsort + ALPHA + STORE also forced",
   318	          c.cmd("SORT", "s:HS", "BY", "nosort", "ALPHA", "STORE", "s:ds2"), 5)
   319	    check("stored set order (alpha)", c.cmd("LRANGE", "s:ds2", "0", "-1"), sorted(members))
   320	    # The rule is set-specific: a list and a zset keep their own order through STORE.
   321	    check("list keeps its order through STORE",
   322	          c.cmd("SORT", "s:L", "BY", "nosort", "STORE", "s:dl2"), 3)
   323	    check("stored list order", c.cmd("LRANGE", "s:dl2", "0", "-1"), ["3", "1", "2"])
   324	    check("zset keeps score order through STORE",
   325	          c.cmd("SORT", "s:Z", "BY", "nosort", "STORE", "s:dz"), 3)
   326	    check("stored zset order", c.cmd("LRANGE", "s:dz", "0", "-1"), ["b", "c", "a"])
   327	    # DESC is honoured for the two ordered types and ignored for a set.
   328	    check("DESC ignored for a set",
   329	          sorted(c.cmd("SORT", "s:HS", "BY", "nosort", "DESC")), sorted(members))
   330	
