   130	def configured_shards(c):
   131	    reply = c.cmd("CONFIG", "GET", "shards")
   132	    if not isinstance(reply, list) or len(reply) != 2 or reply[0] != "shards":
   133	        raise AssertionError("CONFIG GET shards returned %r" % (reply,))
   134	    return int(reply[1])
