+enum class SortDerefWave : uint8_t { Source, Gather, Resolved };
+
+struct SortDerefRequest {
+    std::string key;
+    std::string field;
+    std::string value;
+    uint64_t hash = 0;
+    uint32_t output = 0;
+    int32_t shard = -1;
