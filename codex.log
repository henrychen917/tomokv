    51	        line = self.file.readline()
    52	        if not line:
    53	            raise EOFError
    54	        kind, body = line[:1], line[1:-2]
    55	        if kind == b"+":
    56	            return body.decode()
    57	        if kind == b"-":
    58	            return RuntimeError(body.decode())
    59	        if kind == b":":
    60	            return int(body)
    61	        if kind in (b"$", b"="):
    62	            n = int(body)
    63	            return None if n == -1 else self.file.read(n + 2)[:-2].decode("latin1")
    64	        if kind in (b"*", b"~", b">"):
    65	            n = int(body)
    66	            return None if n == -1 else [self.read() for _ in range(n)]
    67	        if kind == b"%":
    68	            n = int(body)
    69	            return dict((self.read(), self.read()) for _ in range(n))
    70	        if kind == b"_":
    71	            return None
    72	        if kind == b"#":
    73	            return body == b"t"
    74	        if kind == b",":
    75	            return float(body)
    76	        raise AssertionError("unknown reply type %r" % kind)
    77	
    78	    def close(self):
    79	        self.sock.close()
    80	
