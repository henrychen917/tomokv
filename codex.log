   611	FlatStore::SnapshotWriteResult xshard_snapshot_prepare(const Task& task, Shard& shard) {
   612	    ScatterState& state = *task.scatter;
   613	    Op& op = task.client->rob().at(task.op_id);
   614	    auto prepare_group = [&](Shard& owner, ShardGroup& group) {
   615	        if (!owner.store().snapshot_active()) return FlatStore::SnapshotWriteResult::Ready;
   616	        if (state.phase == 1 &&
   617	            !(state.kind == Kind::Mset || state.kind == Kind::Del || state.kind == Kind::Unlink ||
   618	              (state.atomic_write && state.kind == Kind::Msetnx))) {
   619	            if (state.kind == Kind::AllShards && (op.spec->flags & CmdFlags::Write)) {
   620	                try {
   621	                    if (!group.aux) group.aux = new GroupAux;
   622	                    if (!group.aux->flush_keys_built) {
   623	                        owner.store().for_each([&](KvObj* object) {
   624	                            group.aux->flush_keys.emplace_back(object->key().p, object->key().n);
   625	                        });
   626	                        group.aux->flush_keys_built = true;
   627	                    }
   628	                    while (group.snapshot_pos < group.aux->flush_keys.size()) {
   629	                        const std::string& key = group.aux->flush_keys[group.snapshot_pos];
   630	                        const Slice slice(key.data(), static_cast<uint32_t>(key.size()));
   631	                        const auto result = owner.store().snapshot_prepare_write(
   632	                            FlatStore::hash_key(slice), slice);
   633	                        if (result != FlatStore::SnapshotWriteResult::Ready) return result;
   634	                        group.snapshot_pos++;
   635	                    }
   636	                } catch (const std::bad_alloc&) {
   637	                    return FlatStore::SnapshotWriteResult::Error;
   638	                }
   639	            }
   640	            return FlatStore::SnapshotWriteResult::Ready;
   641	        }
   642	        while (group.snapshot_pos < group.count) {
   643	            const uint32_t pos = state.key_order[group.begin + group.snapshot_pos];
   644	            const KeyRef& key = state.keys[pos];
   645	            const auto result = owner.store().snapshot_prepare_write(key.hash, op.arg(key.arg));
   646	            if (result != FlatStore::SnapshotWriteResult::Ready) return result;
   647	            group.snapshot_pos++;
