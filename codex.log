   338	def phase_set_determinism(c):
   339	    """A set has no order, so a STOREd dontsort must not be allowed to be unordered."""
   340	    print("-- set/STORE determinism rule --")
   341	    members = ["delta", "alpha", "charlie", "bravo", "echo"]
   342	    c.cmd("DEL", "s:HS")
   343	    c.cmd("SADD", "s:HS", *members)
   344	    unordered = c.cmd("SORT", "s:HS", "BY", "nosort")
   345	    check("dontsort on a set returns the whole set", sorted(unordered), sorted(members))
   346	    check("dontsort + STORE forces an alphabetic order",
   347	          c.cmd("SORT", "s:HS", "BY", "nosort", "STORE", "s:ds"), 5)
   348	    check("stored set order", c.cmd("LRANGE", "s:ds", "0", "-1"), sorted(members))
   349	    check("dontsort + ALPHA + STORE also forced",
   350	          c.cmd("SORT", "s:HS", "BY", "nosort", "ALPHA", "STORE", "s:ds2"), 5)
   351	    check("stored set order (alpha)", c.cmd("LRANGE", "s:ds2", "0", "-1"), sorted(members))
   352	    # The rule is set-specific: a list and a zset keep their own order through STORE.
   353	    check("list keeps its order through STORE",
   354	          c.cmd("SORT", "s:L", "BY", "nosort", "STORE", "s:dl2"), 3)
   355	    check("stored list order", c.cmd("LRANGE", "s:dl2", "0", "-1"), ["3", "1", "2"])
   356	    check("zset keeps score order through STORE",
   357	          c.cmd("SORT", "s:Z", "BY", "nosort", "STORE", "s:dz"), 3)
   358	    check("stored zset order", c.cmd("LRANGE", "s:dz", "0", "-1"), ["b", "c", "a"])
   359	    # DESC is honoured for the two ordered types and ignored for a set.
   360	    check("DESC ignored for a set",
   361	          sorted(c.cmd("SORT", "s:HS", "BY", "nosort", "DESC")), sorted(members))
   362	
