  1031	            if (watched.shard != shard.id()) continue;
  1032	            shard.watch_remove(Slice(watched.key.data(), static_cast<uint32_t>(watched.key.size())),
  1033	                               state.client, state.watch_generation);
  1034	        }
  1035	    } else {
