    82	def check(label, got, want):
    83	    global checks
    84	    checks += 1
    85	    if isinstance(got, RuntimeError):
    86	        got = "ERR:" + str(got)
    87	    if got != want:
    88	        failures.append("%s: got %r want %r" % (label, got, want))
    89	        print("  FAIL %-52s got=%r want=%r" % (label, got, want))
    90	
