   458	        same &= command.key_shards[i] == command.key_shards[0];
   459	    if (same) return MultiCommandKind::Local;
   460	    if (has_name(command.queued, "mget")) return MultiCommandKind::Mget;
   461	    if (has_name(command.queued, "mset")) return MultiCommandKind::Mset;
   462	    if (has_name(command.queued, "msetnx")) return MultiCommandKind::Msetnx;
   463	    if (has_name(command.queued, "del") || has_name(command.queued, "unlink"))
   464	        return MultiCommandKind::Del;
   465	    if (has_name(command.queued, "exists") || has_name(command.queued, "touch"))
   466	        return MultiCommandKind::Exists;
   467	    return MultiCommandKind::Unsupported;
   468	}
