   111	def placement(c):
   112	    """I/O and executor thread counts from the server's own placement report."""
   113	    found = {}
   114	    for line in str(c.cmd("INFO", "LB")).split("\r\n"):
   115	        if line.startswith("lb_io_threads:") or line.startswith("lb_ex_threads:"):
   116	            key, value = line.split(":", 1)
   117	            found[key] = int(value)
   118	    if "lb_io_threads" not in found or "lb_ex_threads" not in found:
   119	        raise AssertionError("INFO LB did not report I/O and executor thread counts")
   120	    return found["lb_io_threads"], found["lb_ex_threads"]
