   713	        new (&state.owner_record_refs[i]) OwnerRecordRefs;
   714	    for (uint32_t i = 0; state.images && i < state.key_count; i++) new (&state.images[i]) ObjectImage;
   715	    for (uint32_t i = 0; state.apply && i < state.key_count; i++) new (&state.apply[i]) ObjectImage;
   716	}
   717	
   718	void reset_groups(ScatterState& state) {
   719	    for (uint32_t i = 0; i < state.group_cap; i++) {
   720	        ShardGroup& group = state.groups[i];
   721	        delete group.aux;
   722	        group = ShardGroup{};
   723	    }
   724	    if (state.shard_groups)
   725	        std::fill_n(state.shard_groups, state.shard_slots, UINT16_MAX);
   726	    state.nsub = 0;
   727	}
   728	
   729	void build_groups(ScatterState& state, const uint32_t* positions, uint32_t count) {
   730	    uint32_t counts[256] = {};
   731	    for (uint32_t i = 0; i < count; i++) counts[state.keys[positions[i]].shard]++;
   732	    uint32_t cursor = 0;
   733	    for (uint32_t sid = 0; sid < 256; sid++) {
   734	        if (!counts[sid]) continue;
   735	        ShardGroup& group = state.groups[state.nsub++];
   736	        group.shard = static_cast<int32_t>(sid);
   737	        group.begin = cursor;
   738	        group.count = counts[sid];
   739	        if (state.shard_groups)
   740	            state.shard_groups[sid] = static_cast<uint16_t>(state.nsub - 1);
   741	        cursor += counts[sid];
   742	    }
   743	    uint32_t fill[256] = {};
   744	    for (uint32_t i = 0; i < count; i++) {
   745	        const uint32_t pos = positions[i];
   746	        ShardGroup* group = group_for(state, state.keys[pos].shard);
   747	        if (state.atomic_apply)
   748	            group->membership |= atomic_membership_bit(state.keys[pos].hash);
   749	        state.key_order[group->begin + fill[group->shard]++] = pos;
   750	    }
   751	}
   752	
   753	void build_initial_groups(ScatterState& state) {
   754	    if (state.atomic_direct) {
   755	        // Direct movers may defer the destination task until the source image is ready. Preserve
   756	        // source-before-destination order on an executor that owns both shards so its retry queue
   757	        // can never sit ahead of the task that satisfies the dependency.
   758	        for (uint32_t pos = state.phase1_first; pos < state.key_count; pos++) {
   759	            ShardGroup& group = state.groups[state.nsub];
   760	            group.shard = state.keys[pos].shard;
   761	            group.begin = pos - state.phase1_first;
   762	            group.count = 1;
   763	            group.membership = atomic_membership_bit(state.keys[pos].hash);
   764	            state.key_order[group.begin] = pos;
   765	            state.shard_groups[group.shard] = static_cast<uint16_t>(state.nsub++);
   766	        }
   767	        return;
   768	    }
   769	    uint32_t counts[256] = {};
   770	    for (uint32_t pos = state.phase1_first; pos < state.key_count; pos++)
   771	        counts[state.keys[pos].shard]++;
   772	    uint32_t cursor = 0;
   773	    for (uint32_t sid = 0; sid < 256; sid++) {
   774	        if (!counts[sid]) continue;
   775	        ShardGroup& group = state.groups[state.nsub++];
   776	        group.shard = static_cast<int32_t>(sid);
   777	        group.begin = cursor;
   778	        group.count = counts[sid];
   779	        if (state.shard_groups)
   780	            state.shard_groups[sid] = static_cast<uint16_t>(state.nsub - 1);
   781	        cursor += counts[sid];
   782	    }
   783	    uint32_t fill[256] = {};
   784	    if (state.atomic_write) {
   785	        for (uint32_t pos = state.phase1_first; pos < state.key_count; pos++) {
   786	            ShardGroup* group = group_for(state, state.keys[pos].shard);
   787	            group->membership |= atomic_membership_bit(state.keys[pos].hash);
   788	            state.key_order[group->begin + fill[group->shard]++] = pos;
   789	        }
   790	    } else {
   791	        for (uint32_t pos = state.phase1_first; pos < state.key_count; pos++) {
   792	            ShardGroup* group = group_for(state, state.keys[pos].shard);
   793	            state.key_order[group->begin + fill[group->shard]++] = pos;
   794	        }
   795	    }
   796	}
   797	
   798	uint32_t initialize_owner_completion(ScatterState& state) {
   799	    if (!state.atomic_write && !(state.atomic_apply && state.phase == 2)) return state.nsub;
   800	    uint32_t owners = 0;
   801	    for (uint32_t i = 0; i < state.nsub; i++) {
   802	        const uint32_t tid = state.server->worker_of_shard(state.groups[i].shard);
   803	        const uint32_t slot = state.server->executor_slot(tid);
   804	        if (slot >= state.owner_slots) std::abort();
   805	        OwnerRecordRefs& progress = state.owner_record_refs[slot];
   806	        if (progress.group_count++ == 0) owners++;
   807	    }
   808	    for (uint32_t slot = 0; slot < state.owner_slots; slot++)
   809	        if (state.owner_record_refs[slot].group_count)
   810	            state.owner_record_refs[slot].remaining =
   811	                state.owner_record_refs[slot].group_count;
   812	    return owners;
   813	}
   814	
   815	bool publish_phase2(Server& server, ThreadCtx& self, Ring& ring, const Task& task,
   816	                    ScatterState& state) {
   817	    reset_groups(state);
   818	    build_groups(state, state.hop2, state.hop2_count);
   819	    uint32_t needed[kMaxThreads] = {};
   820	    uint32_t participants[kMaxThreads];
   821	    uint16_t routed_owner[256];
   822	    uint32_t nparticipants = 0;
   823	    for (uint32_t i = 0; i < state.nsub; i++) {
   824	        const uint32_t tid = server.worker_of_shard(state.groups[i].shard);
   825	        routed_owner[i] = static_cast<uint16_t>(tid);
   826	        if (needed[tid]++ == 0) participants[nparticipants++] = tid;
   827	    }
   828	    for (uint32_t p = 0; p < nparticipants; p++) {
   829	        const uint32_t tid = participants[p];
   830	        if (server.thread(tid).task_free_slots(self.id()) < needed[tid]) {
   831	            state.final_reply = FinalReply::QueueFull;
   832	            return false;
   833	        }
   834	    }
   835	    state.phase = 2;
   836	    if (!state.external_epoch && !aof_prepare_scatter_group(state)) {
   837	        state.aborted.store(true, std::memory_order_release);
   838	        state.final_reply = FinalReply::Work;
   839	        state.final_error = WorkError::Oom;
   840	        return false;
   841	    }
   842	    state.pending.store(initialize_owner_completion(state), std::memory_order_release);
   843	    Task posts[256];
   844	    uint16_t participant_begin[kMaxThreads];
   845	    uint32_t cursor = 0;
   846	    for (uint32_t p = 0; p < nparticipants; p++) {
   847	        const uint32_t tid = participants[p];
   848	        participant_begin[p] = static_cast<uint16_t>(cursor);
   849	        cursor += needed[tid];
   850	        needed[tid] = participant_begin[p];
   851	    }
   852	    for (uint32_t i = 0; i < state.nsub; i++)
   853	        posts[needed[routed_owner[i]]++] = Task{
   854	            task.client, task.op_id, state.groups[i].shard, &state};
   855	    if (cursor != state.nsub) std::abort();
   856	    for (uint32_t p = 0; p < nparticipants; p++) {
   857	        const uint32_t tid = participants[p];
   858	        const uint32_t begin = participant_begin[p];
   859	        const uint32_t end = p + 1 < nparticipants ? participant_begin[p + 1] : state.nsub;
   860	        ThreadCtx& owner = server.thread(tid);
   861	        if (!owner.post_tasks_quiet(self.id(), posts + begin, end - begin, self.sig()))
   862	            std::abort();
   863	        owner.flush_task_notify(self.id(), ring, self.sig());
   864	    }
   865	    return true;
   866	}
   867	
   868	bool publish_pop_retry(Server& server, ThreadCtx& self, Ring& ring, const Task& task,
   869	                       ScatterState& state) {
   870	    for (uint32_t i = 0; i < state.key_count; i++) {
   871	        state.hop2[i] = i;
   872	        state.images[i] = ObjectImage{};
   873	    }
   874	    if (state.status) std::memset(state.status, 0, state.key_count);
   875	    if (state.result) {
   876	        state.result->members.clear();
   877	        state.result->scores.clear();
   878	    }
   879	    state.selected = std::numeric_limits<uint32_t>::max();
   880	    state.pop_missed = false;
   881	    reset_groups(state);
   882	    build_groups(state, state.hop2, state.key_count);
   883	
   884	    uint32_t needed[kMaxThreads] = {};
   885	    uint32_t participants[kMaxThreads];
   886	    uint16_t routed_owner[256];
   887	    uint32_t nparticipants = 0;
   888	    for (uint32_t i = 0; i < state.nsub; i++) {
   889	        const uint32_t tid = server.worker_of_shard(state.groups[i].shard);
   890	        routed_owner[i] = static_cast<uint16_t>(tid);
   891	        if (needed[tid]++ == 0) participants[nparticipants++] = tid;
   892	    }
   893	    for (uint32_t p = 0; p < nparticipants; p++) {
   894	        const uint32_t tid = participants[p];
   895	        if (server.thread(tid).task_free_slots(self.id()) < needed[tid]) {
   896	            state.final_reply = FinalReply::QueueFull;
   897	            return false;
   898	        }
   899	    }
   900	
   901	    state.phase = 1;
   902	    state.pop_retry_snapshot = server.atomic_snapshot();
   903	    state.pending.store(state.nsub, std::memory_order_release);
   904	    Task posts[256];
   905	    uint16_t participant_begin[kMaxThreads];
   906	    uint32_t cursor = 0;
   907	    for (uint32_t p = 0; p < nparticipants; p++) {
   908	        const uint32_t tid = participants[p];
   909	        participant_begin[p] = static_cast<uint16_t>(cursor);
   910	        cursor += needed[tid];
   911	        needed[tid] = participant_begin[p];
   912	    }
   913	    for (uint32_t i = 0; i < state.nsub; i++)
   914	        posts[needed[routed_owner[i]]++] = Task{
   915	            task.client, task.op_id, state.groups[i].shard, &state};
   916	    if (cursor != state.nsub) std::abort();
   917	    for (uint32_t p = 0; p < nparticipants; p++) {
   918	        const uint32_t tid = participants[p];
   919	        const uint32_t begin = participant_begin[p];
   920	        const uint32_t end = p + 1 < nparticipants ? participant_begin[p + 1] : state.nsub;
   921	        ThreadCtx& owner = server.thread(tid);
   922	        if (!owner.post_tasks_quiet(self.id(), posts + begin, end - begin, self.sig()))
   923	            std::abort();
   924	        owner.flush_task_notify(self.id(), ring, self.sig());
   925	    }
   926	    return true;
   927	}
   928	
   929	void free_state_contents(ScatterState& state) {
   930	    if (state.contents_freed) return;
   931	    for (uint32_t i = 0; i < state.group_cap; i++) delete state.groups[i].aux;
   932	    for (uint32_t i = 0; state.images && i < state.key_count; i++) state.images[i].~ObjectImage();
   933	    for (uint32_t i = 0; state.apply && i < state.key_count; i++) state.apply[i].~ObjectImage();
   934	    delete state.result;
   935	    state.contents_freed = true;
   936	}
   937	
   938	void free_state_key_anchors(ScatterState& state) {
   939	    for (uint32_t i = 0; i < state.key_count; i++) {
   940	        if (!state.keys[i].key_anchor) continue;
  1270	    uint32_t phase1_first = (is_store_setop(kind) || is_store_zsetop(kind) ||
  1271	                             (is_geo_kind(kind) && geo_route.store) || kind == Kind::Bitop ||
  1272	                             kind == Kind::Zrangestore ||
  1273	                             (kind == Kind::Sort && sort_options.store)) ? 1u : 0u;
  1274	    uint32_t group_cap = 0;
  1275	    if (kind == Kind::AllShards || kind == Kind::DebugReload || kind == Kind::DebugLoadAof ||
  1276	        kind == Kind::DbsizeExact || kind == Kind::Keys) {
  1277	        group_cap = server.nshards();
  1278	    } else if (atomic_write) {
  1279	        bool seen[256] = {};
  1280	        for (uint32_t i = phase1_first; i < key_count; i++)
  1281	            if (!seen[static_cast<uint32_t>(routes[i].shard)]) {
  1282	                seen[static_cast<uint32_t>(routes[i].shard)] = true;
  1283	                group_cap++;
  1284	            }
  1285	    } else {
  1286	        for (uint32_t i = phase1_first; i < key_count; i++) {
  1287	            bool first = true;
  1288	            for (uint32_t prior = phase1_first; prior < i; prior++)
  1289	                if (routes[prior].shard == routes[i].shard) {
  1290	                    first = false;
  1291	                    break;
  1292	                }
  1293	            group_cap += first;
  1294	        }
  1295	    }
  1296	    // A CROSS-SHARD READ CARRIES A CUT WHETHER OR NOT A GROUP HAPPENS TO BE IN FLIGHT RIGHT NOW.
  1297	    // `tracking` is a sample of atomic_activity_, and EXEC is what writes that word: EXEC
  1298	    // force-admits (multi.inc:948) even at --atomic 0, so the word reads zero in every gap between
  1299	    // transactions. A read prepared in such a gap left state->snapshot at UINT64_MAX, which makes
  1300	    // ReadEpochGuard (below) leave the owner unbound, and every fragment then answers "newest
  1301	    // committed at the instant this fragment runs". A transaction publishing its one ticket
  1302	    // (multi.inc:1352) while the fan-out is in flight is therefore seen by the fragments that
  1303	    // execute after it and missed by those that executed before -- one MGET, two transactions.
  1304	    // Contention does not cause that; it only widens the fan-out from microseconds to milliseconds,
  1305	    // which is why a quiet gate never caught it.
  1306	    // Scoped exactly to the commands that can straddle: a read whose fragments run on more than one
  1307	    // owner. A single-owner scatter resolves in one task and cannot straddle anything, and a write
  1308	    // group keeps the old gate because at --atomic 0 it is not a group and promises concurrent
  1309	    // readers nothing that a cut would buy.
  1310	    const bool read_fanout = group_cap > 1 &&
  1311	        !(op.spec->flags & (CmdFlags::Write | CmdFlags::SnapshotWrite));
  1312	    const bool needs_snapshot = kind == Kind::Script || (!force_atomic && (tracking || read_fanout) &&
  1313	        (key_count || kind == Kind::Keys || kind == Kind::DbsizeExact) &&
  1314	        !(atomic_write && kind == Kind::Mset));
  1315	    if (kind == Kind::Script &&
  1316	        !pool.can_register_snapshot(server.script_crossshard_cut_slots())) {
  1317	        if (routes != route_stack) delete[] routes;
  1318	        server.note_script_window_refusal();
  1319	        reply_err(op.sink(), "BUSY Cross-shard script snapshot window is full");
  1320	        return ScatterPrepare::Error;
  1321	    }
  1322	    if (needs_snapshot && (atomic_mode & ~Server::kAtomicEnabledBit) &&
  1323	        !pool.can_register_snapshot()) {
  1324	        if (routes != route_stack) delete[] routes;
  1325	        return ScatterPrepare::Backpressure;
  1326	    }
  1327	    bool admitted = false;
  1328	    uint64_t admission_generation = 0;
  1329	    if (atomic_group && !force_atomic) {
  1330	        if (!server.atomic_try_admit(owner_io, admission_generation,
  1331	                                     kind == Kind::Script || script_guard)) {
  1332	            if (routes != route_stack) delete[] routes;
  1333	            return ScatterPrepare::Backpressure;
  1334	        }
  1335	        admitted = true;
  1336	    }
  1337	    const size_t bytes = arena_layout_bytes(
  1338	        kind, key_count, group_cap, server.nshards(), atomic_write, atomic_apply,
  1339	        static_cast<uint32_t>(server.placement().ex_threads().size()));
  1340	    if (bytes == std::numeric_limits<size_t>::max() || bytes > UINT32_MAX) {
  1341	        if (admitted) server.atomic_retire_group(owner_io, admission_generation);
  1342	        if (routes != route_stack) delete[] routes;
  1343	        set_oom(op);
  1344	        return ScatterPrepare::Error;
  1345	    }
  1346	    bool pooled = false;
  1347	    void* memory = pool.acquire(bytes, pooled);
  1348	    if (!memory) {
  1349	        if (admitted) server.atomic_retire_group(owner_io, admission_generation);
  1350	        if (routes != route_stack) delete[] routes;
  1351	        set_oom(op);
  1352	        return ScatterPrepare::Error;
  1353	    }
  1354	    auto* state = new (memory) ScatterState;
  1355	    state->kind = kind;
  1356	    state->atomic_write = atomic_write;
  1357	    state->atomic_apply = atomic_apply;
  1358	    state->atomic_pop = atomic_pop;
  1359	    state->atomic_group = atomic_group;
  1360	    state->atomic_direct = atomic_direct;
  1361	    if (__builtin_expect(atomic_direct, false))
  1362	        state->debug_direct_defer = server.debug_atomic_direct_defer();
  1363	    state->phase = atomic_direct ? 2 : 1;
  1364	    state->script_phase = kind == Kind::Script ? ScriptPhase::Pin : ScriptPhase::None;
  1365	    state->two_hop = is_two_hop(kind) && !atomic_write && !atomic_direct;
  1366	    state->barrier = state->two_hop || all_shards;
  1367	    state->admitted = admitted;
  1368	    state->server = &server;
  1369	    // Opened only once state->server is set, so "apply_open is true" always implies xshard_destroy
  1370	    // can close it. The two failure arms above return before any ScatterState exists at all, so
  1371	    // the window can never be opened on a group with nothing to close it.
  1372	    if (__builtin_expect(admitted, false)) server.atomic_apply_open(state->apply_open);
  1373	    state->pooled = pooled;
  1374	    state->owner_io = owner_io;
  1375	    state->owner_slots = static_cast<uint32_t>(server.placement().ex_threads().size());
  1376	    state->admission_generation = admission_generation;
  1377	    state->origin_conn_id = origin_conn_id;
  1378	    state->script_coordinator_shard = kind == Kind::Script && key_count
  1379	        ? routes[0].shard : -1;
  1380	    // One wall-clock read per cross-shard group, taken here because this is the point the
  1381	    // connection's program order already uses for the commit cut a few lines below. Every owner of
  1382	    // this group then answers deadlines against this one instant, which is what the reference does
  1383	    // for a multi-key read (redis pins server.mstime for the whole command).
  1384	    state->now_cut_ms = now_realtime_ms();
  1385	    state->arena_bytes = static_cast<uint32_t>(bytes);
  1386	    state->key_count = key_count;
  1387	    state->group_cap = group_cap;
  1388	    state->shard_slots = (atomic_write || atomic_apply) ? server.nshards() : 0;
  1389	    state->phase1_first = phase1_first;
  1390	    state->copy_replace = copy_replace;
  1391	    state->from_left = from_left;
  1392	    state->to_left = to_left;
  1393	    state->pop_edge = pop_edge;
  1394	    state->pop_count = pop_count;
  1395	    state->xread_count = xread_options.count;
  1396	    state->xread_first_key = xread_options.first_key;
  1397	    state->xread_first_id = xread_options.first_id;
  1398	    state->sinter_limit = sinter_limit;
  1399	    state->zset_limit = zset_limit;
  1400	    state->zset_aggregate = zset_aggregate;
  1401	    state->zset_withscores = zset_withscores;
  1402	    state->zset_weights = std::move(zset_weights);
  1403	    state->geo_store = geo_route.store;
  1404	    state->geo_store_distance = geo_route.store_distance;
  1405	    state->geo_source_arg = geo_route.source_arg;
  1406	    state->geo_destination_arg = geo_route.destination_arg;
  1407	    state->lcs_options = lcs_options;
  1408	    state->range_options = range_options;
  1409	    state->range_spec = range_spec;
  1410	    state->sort_options = sort_options;
  1411	    state->reload_plan = std::move(reload_plan);
  1412	    state->aof_reload_base = std::move(aof_reload_base);
  1413	    state->aof_reload_increments = std::move(aof_reload_increments);
  1414	    // MSET is a blind replacement. Registering a read cut for it only pins predecessors across a
  1415	    // deep pipeline; MSETNX and delete still need their one dispatch snapshot for existence.
  1416	    // A read that IO already stamped reuses that exact cut, so a plain read and a multi-key read
  1417	    // prepared back to back on one connection cannot disagree about which of them is older.
  1418	    if (needs_snapshot) {
  1419	        state->snapshot = op.has_read_cut() ? op.read_cut(server.atomic_snapshot())
  1420	                                            : server.atomic_snapshot();
  1421	        // Vacuous-validation guard: this counts exactly the reads the old `tracking` gate sent out
  1422	        // cut-less. A regression for the fan-out defect that never moves it never armed the window.
  1423	        if (!tracking) server.note_atomic_fanout_cut();
  1424	        // Instrumentation, once per multi-key command and never on the GET/SET path: the visible
  1425	        // watermark trailing the drawn sequence is the publication guard actively excluding an
  1426	        // undecided ticket from this read's cut. A battery that never sees this counter move never
  1427	        // entered the window it claims to close.
  1428	        if (__builtin_expect(server.atomic_snapshot() < server.atomic_commit_drawn(), false))
  1429	            server.note_atomic_commit_hold();
  1430	    }
  1431	    if (kind == Kind::Sintercard) { state->set_first = 0; state->set_count = sinter_count; }
  1432	    else if (is_store_setop(kind)) { state->set_first = 1; state->set_count = key_count - 1; }
  1433	    else if (is_plain_setop(kind)) { state->set_first = 0; state->set_count = key_count; }
  1434	    else if (is_store_zsetop(kind)) { state->set_first = 1; state->set_count = zset_count; }
  1435	    else if (is_plain_zsetop(kind) || kind == Kind::Zintercard) {
  1436	        state->set_first = 0;
  1437	        state->set_count = zset_count;
  1438	    }
  1439	    init_arena_arrays(*state);
  1440	    for (uint32_t i = 0; i < key_count; i++)
  1441	        state->keys[i] = KeyRef{routes[i].hash, routes[i].arg, routes[i].shard};
  1442	    if (routes != route_stack) delete[] routes;
  1443	
  1444	    // Blind string values belong to the op's IO thread until an owner links them. Allocation and
  1445	    // memcpy therefore run on the underutilized stage without touching a shard or shard metadata.
  1446	    // key_anchor is the ownership bit: an owner clears it only after atomic_install_group takes the
  1447	    // object; abandonment and prepare failures leave it for IO-side destruction.
  1448	    if (atomic_write && (kind == Kind::Mset || kind == Kind::Msetnx)) {
  1449	        for (uint32_t i = 0; i < key_count; i++) {
  1450	            KeyRef& key = state->keys[i];
  1451	            // Small/int objects already come from the shard owner's hot value pool. Moving those to
  1452	            // generic jemalloc regressed MSET-8 despite shifting cycles to IO. Large strings bypass
  1453	            // that pool in V3, so prebuild precisely the allocation+memcpy work that was already a
  1454	            // heap operation and preserve the allocation-free common cell.
  1455	            if (op.arg(key.arg + 1).n <= kEmbedThreshold) continue;
  1456	            KvObj* value = xshard_make_string(op.arg(key.arg), op.arg(key.arg + 1));
  1457	            if (!value) {
  1458	                set_oom(op);
  1459	                xshard_destroy(state, pool, owner_io);
  1460	                return ScatterPrepare::Error;
  1461	            }
  1462	            key.stable_object = value;
  1463	            key.key_anchor = value;
  1464	        }
  1465	    }
  1466	
  1467	    if (state->snapshot != UINT64_MAX && !pool.register_snapshot(server, state, owner_io)) {
  1468	        set_oom(op);
  1469	        xshard_destroy(state, pool, owner_io);
  1470	        return ScatterPrepare::Error;
  1471	    }
  1472	
  1473	    if (kind == Kind::AllShards || kind == Kind::DebugReload || kind == Kind::DebugLoadAof ||
  1474	        kind == Kind::DbsizeExact || kind == Kind::Keys) {
  1475	        state->nsub = server.nshards();
  1476	        for (uint32_t sid = 0; sid < state->nsub; sid++) {
  1477	            state->groups[sid].shard = sid;
  1478	            if (state->shard_groups)
  1479	                state->shard_groups[sid] = static_cast<uint16_t>(sid);
  1480	        }
  1481	    } else {
  1482	        build_initial_groups(*state);
  1483	    }
  1484	    // TEST HOOK arming, after the groups exist so a lead shard can be named. Only cross-shard READS
  1485	    // arm it: they are the commands whose fragments each answer at their own moment.
  1486	    if (__builtin_expect(state->nsub > 1, false) &&
  1487	        !(op.spec->flags & (CmdFlags::Write | CmdFlags::SnapshotWrite))) {
  1488	        const uint32_t fanout_defer = server.debug_atomic_fanout_defer();
  1489	        if (__builtin_expect(fanout_defer != 0, false)) {
  1490	            state->debug_fanout_lead = state->groups[0].shard;
  1491	            state->debug_fanout_deadline =
  1492	                now_ns() + static_cast<uint64_t>(fanout_defer) * 1000ull;
  1493	        }
  1494	    }
  1495	    // TEST HOOK arming for the cross-owner script GATHER wave. A script is a Write row, so it can
  1496	    // never reach the read-only arm above; it gets its own deadline, consumed in the Read phase.
  1497	    if (__builtin_expect(kind == Kind::Script, false)) {
  1498	        const uint32_t stage_defer = server.debug_script_stage_defer();
  1499	        if (__builtin_expect(stage_defer != 0, false))
  1500	            state->debug_script_defer_us = stage_defer;
  1501	    }
  1502	    state->pending.store(initialize_owner_completion(*state), std::memory_order_relaxed);
  1503	    if (state->atomic_group && !force_atomic &&
  1504	        (state->atomic_write || state->atomic_direct) &&
  1505	        !aof_prepare_scatter_group(*state)) {
  1506	        xshard_destroy(state, pool, owner_io);
  1507	        set_oom(op);
  1508	        return ScatterPrepare::Error;
  1509	    }
  1510	    dispatch.state = state;
  1511	    dispatch.nshards = state->nsub;
  1512	    dispatch.barrier = state->barrier;
  1513	    dispatch.atomic_write = state->atomic_group;
  1514	    return ScatterPrepare::Ready;
  1515	}
  1516	
  1517	int32_t xshard_dispatch_shard(const ScatterDispatch& dispatch, uint32_t index) {
  1518	    if (!dispatch.state) return -1;
  1519	    return index < dispatch.state->nsub ? dispatch.state->groups[index].shard : -1;
  1520	}
  1521	
  1522	void xshard_destroy(ScatterState* state, ScatterArenaPool& pool, uint32_t owner_io) {
  1523	    if (!state) return;
  1524	    if (state->owner_io != owner_io) std::abort();
  1525	    if (state->snapshot_registered && state->server)
  1780	            const uint32_t tid = server.worker_of_shard(state.groups[i].shard);
  1781	            if (needed[tid]++ == 0) participants[nparticipants++] = tid;
  1782	        }
  1783	    }
  1784	    for (uint32_t p = 0; p < nparticipants; p++) {
  1785	        const uint32_t tid = participants[p];
  1786	        if (server.thread(tid).task_free_slots(self.id()) < needed[tid])
  1787	            return ScriptPostResult::Full;
  1788	    }
  1789	    if (phase == ScriptPhase::Apply && !state.aof_group &&
  1790	        !aof_prepare_scatter_group(state)) {
  1791	        state.final_error = WorkError::Oom;
  1792	        state.aborted.store(true, std::memory_order_release);
  1793	        return ScriptPostResult::Empty;
  1794	    }
  1795	
  1796	    // THE +1 IS THE POSTER'S OWN REFERENCE and it is load-bearing. Owner tasks become visible one
  1797	    // participant at a time, so without it the LAST task could finish and try to advance the wave
  1798	    // while this thread was still inside the publishing loop -- and the next wave's build_groups()
  1799	    // would then rewrite state.groups under a thread already reading it. Two executors inside
  1800	    // build_groups() on one arena is exactly how the differ's script leg segfaulted. The poster
  1801	    // releases this reference in xshard_complete_script() once publication is complete.
  1802	    state.pending.store((phase == ScriptPhase::Run ? 1u : state.nsub) + 1u,
  1803	                        std::memory_order_release);
  1804	    if (phase == ScriptPhase::Run) {
  1805	        ThreadCtx& owner = server.thread(participants[0]);
  1806	        const Task post{source.client, source.op_id, one_shard, &state};
  1807	        if (!owner.post_task_quiet(self.id(), post, self.sig())) std::abort();
  1808	        owner.flush_task_notify(self.id(), ring, self.sig());
  1809	        return ScriptPostResult::Posted;
  1810	    }
  1811	
  1812	    Task posts[256];
  1813	    uint16_t begin[kMaxThreads];
  1814	    uint32_t cursor = 0;
  1815	    for (uint32_t p = 0; p < nparticipants; p++) {
  1816	        begin[p] = static_cast<uint16_t>(cursor);
  1817	        cursor += needed[participants[p]];
  1818	        needed[participants[p]] = begin[p];
  1819	    }
  1820	    for (uint32_t i = 0; i < state.nsub; i++) {
  1821	        const uint32_t tid = server.worker_of_shard(state.groups[i].shard);
  1822	        posts[needed[tid]++] = Task{source.client, source.op_id, state.groups[i].shard, &state};
  1823	    }
  1824	    for (uint32_t p = 0; p < nparticipants; p++) {
  1825	        const uint32_t tid = participants[p];
  1826	        const uint32_t end = p + 1 < nparticipants ? begin[p + 1] : cursor;
  1827	        ThreadCtx& owner = server.thread(tid);
  1828	        if (!owner.post_tasks_quiet(self.id(), posts + begin[p], end - begin[p], self.sig()))
  1829	            std::abort();
  1830	        owner.flush_task_notify(self.id(), ring, self.sig());
  1831	    }
  1832	    return ScriptPostResult::Posted;
  1833	}
  1834	
  1835	struct ScriptWorkbench {
  1836	    std::unique_ptr<Shard> shard;
  1837	    Server* server = nullptr;
  1838	};
  1839	thread_local ScriptWorkbench t_script_workbench;
  1840	
  1841	Shard* script_workbench(Server& server, int32_t coordinator) {
  1842	    if (!t_script_workbench.shard) {
  1843	        auto shard = std::make_unique<Shard>();
  1844	        shard->init_private(&server, coordinator, server.cfg().type_limits,
  1845	                            server.cfg().stream_limits);
  1846	        t_script_workbench.server = &server;
  1847	        t_script_workbench.shard = std::move(shard);
  1848	    }
  1849	    if (t_script_workbench.server != &server) std::abort();
  1850	    Shard* workbench = t_script_workbench.shard.get();
  1851	    // One executor can coordinate activations for different KEYS[1] owners, so re-stamp the
  1852	    // identity when it changes. Nothing in the whitelisted handler set consults shard.id() today
  1853	    // except the zero-copy borrow, which zc_min == UINT32_MAX already makes unreachable here --
  1854	    // but a stale id is the kind of thing the next handler quietly inherits. Re-stamping also
  1855	    // picks up live CONFIG SET changes to the type/stream limits.
  1856	    if (workbench->id() != coordinator)
  1857	        workbench->init_private(&server, coordinator, server.cfg().type_limits,
  1858	                                server.cfg().stream_limits);
  1859	    return workbench;
  1860	}
