   670	template <typename T>
   671	T* carve_at(char* base, size_t& off, uint32_t count) {
   672	    if (!count) return nullptr;
   673	    const size_t align = alignof(T);
   674	    off = (off + align - 1) & ~(align - 1);
   675	    T* result = reinterpret_cast<T*>(base + off);
   676	    off += sizeof(T) * static_cast<size_t>(count);
   677	    return result;
   678	}
