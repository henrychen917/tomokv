   137	def find_cross_owner_pattern(c, source, stem, elements, executors):
   138	    """Find a pattern with a concrete key on an executor other than `source`'s."""
   139	    source_shard = shard_of(c, source)
   140	    source_owner = source_shard % executors
   141	    by_shard = {}
   142	    for candidate in range(4096):
   143	        prefix = "%s:%04d:" % (stem, candidate)
   144	        routed = []
   145	        for element in elements:
   146	            key = prefix + element
   147	            shard = shard_of(c, key)
   148	            by_shard.setdefault(shard, []).append(key)
   149	            routed.append((element, key, shard))
   150	        for element, key, shard in routed:
   151	            if shard % executors != source_owner:
   152	                return prefix + "*", element, key, source_shard, shard, by_shard
   153	    raise AssertionError(
   154	        "DEBUG SHARD found no cross-owner %s pattern after 4096 candidates; source shard=%d, "
   155	        "observed shards=%r" % (stem, source_shard, sorted(by_shard)))
   156	
   157	
   158	def find_cross_owner_key(c, source, stem, executors):
   159	    source_shard = shard_of(c, source)
   160	    source_owner = source_shard % executors
   161	    by_shard = {}
   162	    for candidate in range(4096):
   163	        key = "%s:%04d" % (stem, candidate)
   164	        shard = shard_of(c, key)
   165	        by_shard.setdefault(shard, key)
   166	        if shard % executors != source_owner:
   167	            return key, source_shard, shard, by_shard
   168	    raise AssertionError(
   169	        "DEBUG SHARD found no cross-owner %s key after 4096 candidates; source shard=%d, "
   170	        "observed shards=%r" % (stem, source_shard, sorted(by_shard)))
   171	
