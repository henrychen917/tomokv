    92	def check_err(label, got, prefix):
    93	    global checks
    94	    checks += 1
    95	    text = str(got) if isinstance(got, RuntimeError) else repr(got)
    96	    if not (isinstance(got, RuntimeError) and text.startswith(prefix)):
    97	        failures.append("%s: got %r want prefix %r" % (label, text, prefix))
    98	        print("  FAIL %-52s got=%r want prefix=%r" % (label, text[:60], prefix))
