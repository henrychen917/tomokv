   364	def phase_scatter_arm(c, one_executor):
   365	    """The cross-shard engine arm: a STORE whose destination lands on another shard."""
   366	    print("-- cross-shard arm --")
   367	    before = stats(c)
   368	    names = ["s:sc%d" % i for i in range(12)]
   369	    for name in names:
   370	        if one_executor:
   371	            got = c.cmd("SORT", "s:L", "BY", "s:w_*", "GET", "s:d_*", "STORE", name)
   372	            check("scatter STORE %s" % name, got, 3)
   373	            check("scatter STORE %s contents" % name, c.cmd("LRANGE", name, "0", "-1"),
   374	                  ["three", "two", "one"])
   375	        else:
   376	            got = c.cmd("SORT", "s:L", "BY", "nosort", "GET", "#", "STORE", name)
   377	            check("scatter STORE %s" % name, got, 3)
   378	            check("scatter STORE %s contents" % name, c.cmd("LRANGE", name, "0", "-1"),
   379	                  ["3", "1", "2"])
   380	    after = stats(c)
   380	    after = stats(c)
   381	    fired = after["sort_scatter_general"] - before["sort_scatter_general"]
   382	    if fired <= 0:
   383	        failures.append("cross-shard SORT arm never ran (sort_scatter_general did not move)")
   384	        print("  FAIL cross-shard SORT arm never ran")
   385	    else:
   386	        print("  cross-shard arm ran %d times" % fired)
   387	    global checks
   388	    checks += 1
