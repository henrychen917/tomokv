    15	VACUOUS-VALIDATION GUARD.  Replies alone cannot tell a dereference that ran from patterns that
    16	resolved to nothing, nor a refusal from an unrelated failure, nor which of the two execution arms
    17	(localfast / cross-shard engine) served the command.  Every phase below therefore asserts on INFO's
    18	sort_deref_lookups, sort_deref_refusals, sort_scatter_general and sort_deref_escapes, and each is
    19	another phase's negative control: the refusal phase must report zero lookups, the deref phase must
    20	report zero refusals, and sort_deref_escapes must be zero everywhere.
    21	"""
    22	
    23	import random
    24	import socket
    25	import sys
    26	
    27	HOST, PORT = sys.argv[1], int(sys.argv[2])
    28	SEED = int(sys.argv[3]) if len(sys.argv) > 3 else 17
    29	failures = []
    30	checks = 0
    31	
    32	
    33	def encode(*args):
    34	    out = [b"*%d\r\n" % len(args)]
    35	    for arg in args:
    36	        if isinstance(arg, str):
    37	            arg = arg.encode("latin1")
    38	        out.append(b"$%d\r\n" % len(arg) + arg + b"\r\n")
    39	    return b"".join(out)
    40	
    41	
    42	class Conn:
    43	    def __init__(self, timeout=60):
    44	        self.sock = socket.create_connection((HOST, PORT), timeout=timeout)
    45	        self.sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
    46	        self.file = self.sock.makefile("rb")
    47	
    48	    def cmd(self, *args):
    49	        self.sock.sendall(encode(*args))
    50	        return self.read()
    51	
    52	    def read(self):
    53	        line = self.file.readline()
    54	        if not line:
    55	            raise EOFError
    56	        kind, body = line[:1], line[1:-2]
    57	        if kind == b"+":
    58	            return body.decode()
    59	        if kind == b"-":
    60	            return RuntimeError(body.decode())
    61	        if kind == b":":
    62	            return int(body)
    63	        if kind in (b"$", b"="):
    64	            n = int(body)
    65	            return None if n == -1 else self.file.read(n + 2)[:-2].decode("latin1")
    66	        if kind in (b"*", b"~", b">"):
    67	            n = int(body)
    68	            return None if n == -1 else [self.read() for _ in range(n)]
    69	        if kind == b"%":
    70	            n = int(body)
    71	            return dict((self.read(), self.read()) for _ in range(n))
    72	        if kind == b"_":
    73	            return None
    74	        if kind == b"#":
    75	            return body == b"t"
    76	        if kind == b",":
    77	            return float(body)
    78	        raise AssertionError("unknown reply type %r" % kind)
    79	
    80	    def close(self):
    81	        self.sock.close()
    82	
    83	
    84	def check(label, got, want):
    85	    global checks
    86	    checks += 1
    87	    if isinstance(got, RuntimeError):
    88	        got = "ERR:" + str(got)
    89	    if got != want:
    90	        failures.append("%s: got %r want %r" % (label, got, want))
    91	        print("  FAIL %-52s got=%r want=%r" % (label, got, want))
    92	
    93	
    94	def check_err(label, got, prefix):
    95	    global checks
    96	    checks += 1
    97	    text = str(got) if isinstance(got, RuntimeError) else repr(got)
    98	    if not (isinstance(got, RuntimeError) and text.startswith(prefix)):
    99	        failures.append("%s: got %r want prefix %r" % (label, text, prefix))
   100	        print("  FAIL %-52s got=%r want prefix=%r" % (label, text[:60], prefix))
   101	
   102	
   103	def stats(c):
   104	    text = c.cmd("INFO", "stats")
   105	    out = {}
   106	    for line in text.split("\r\n"):
   107	        if ":" in line and line.startswith("sort_"):
   108	            key, value = line.split(":", 1)
   109	            out[key] = int(value)
   110	    return out
   111	
   112	
   113	def executors(c):
   114	    """Number of ex threads, read from the server's own placement report."""
   115	    for line in str(c.cmd("INFO", "LB")).split("\r\n"):
   116	        if line.startswith("lb_ex_threads:"):
   117	            return int(line.split(":", 1)[1])
   118	    raise AssertionError("INFO LB did not report lb_ex_threads")
