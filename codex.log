   222	    // guard tests the parsed count against the -1 default and ignores the offset entirely, so
   223	    // "ZRANGE k 0 -1 LIMIT 0 -1" (and any offset with count -1) is accepted and the LIMIT is a
   224	    // no-op. Client libraries that always emit LIMIT depend on that.
   225	    if (options.limit_seen && options.limit != -1 && options.kind == ImageRangeKind::Rank) {
   226	        reply_err(op.sink(),
   227	                  "ERR syntax error, LIMIT is only supported in combination with either BYSCORE or BYLEX");
   228	        return false;
   229	    }
   230	    return true;
   231	}
   232	
   233	// `admit` is non-null only where the reply is authoritative (xshard_prepare, once per command).
   234	// The other call sites -- routing's key walk and the snapshot-write gate -- re-parse the same argv
   235	// purely to find the STORE destination and must not decide policy or write a reply twice.
   236	//
   237	// PRECEDENCE.  The single-owner refusal fires the instant the offending option is PARSED, which is
   238	// where the reference's cluster-mode refusal fires too: `SORT k BY w_* NONSENSE` is a BY refusal
   239	// and `SORT k NONSENSE BY w_*` is a syntax error, in both servers.
   240	bool parse_sort_options(Op& op, SortOptions& options, Server* admit) {
   241	    for (uint32_t i = 2; i < op.argc(); i++) {
   242	        if (op.arg(i).eq_icase("alpha")) {
   243	            options.alpha = true;
   244	        } else if (op.arg(i).eq_icase("asc")) {
   245	            options.descending = false;
   246	        } else if (op.arg(i).eq_icase("desc")) {
   247	            options.descending = true;
   248	        } else if (op.arg(i).eq_icase("limit") && i + 2 < op.argc()) {
   249	            if (!parse_i64(op.arg(i + 1), options.offset) ||
   250	                !parse_i64(op.arg(i + 2), options.count)) {
   251	                reply_invalid_integer(op);
   252	                return false;
   253	            }
   254	            i += 2;
   255	        } else if (op.arg(i).eq_icase("by") && i + 1 < op.argc()) {
   256	            options.by_arg = ++i;
   257	            // A BY pattern with no '*' dereferences nothing -- it only suppresses ordering -- so it
   258	            // is admitted in every configuration.
   259	            if (std::memchr(op.arg(options.by_arg).p, '*', op.arg(options.by_arg).n)) {
   260	                options.deref = true;
   261	                if (admit && !sort_deref_local(*admit)) {
   262	                    admit->note_sort_deref_refusal();
   263	                    reply_err(op.sink(), kSortByDenied);
   264	                    return false;
   265	                }
   266	            }
   267	        } else if (op.arg(i).eq_icase("get") && i + 1 < op.argc()) {
   268	            const uint32_t arg = ++i;
   269	            // `#` is the element itself and a pattern with no '*' is a constant nil, so neither
   270	            // reads a key.  Only a '*'-bearing pattern needs the admission rule -- the reference's
   271	            // cluster check is coarser here and refuses every GET that is not `#`; matching the
   272	            // standalone reply byte-for-byte is worth the deliberate divergence.
   273	            const Slice pattern = op.arg(arg);
   274	            const bool reads_a_key = !(pattern.n == 1 && pattern.p[0] == '#') &&
   275	                                     std::memchr(pattern.p, '*', pattern.n) != nullptr;
   276	            if (reads_a_key) {
   277	                options.deref = true;
   278	                if (admit && !sort_deref_local(*admit)) {
   279	                    admit->note_sort_deref_refusal();
   280	                    reply_err(op.sink(), kSortGetDenied);
   281	                    return false;
   282	                }
   283	            }
   284	            try {
   285	                options.get_args.push_back(arg);
   286	            } catch (const std::bad_alloc&) {
   287	                set_oom(op);
   288	                return false;
   289	            }
   290	        } else if (op.arg(i).eq_icase("store") && i + 1 < op.argc()) {
   291	            // SORT_RO is the read-only alias: it shares every option EXCEPT STORE, which would
   292	            // make it a write. Redis reports the rejection as a plain syntax error.
   293	            if (name_is(op, "SORT_RO")) { reply_syntax(op.sink()); return false; }
   294	            options.store = true;
   295	            options.store_arg = ++i;
   296	        } else {
   297	            reply_syntax(op.sink());
   298	            return false;
   299	        }
   300	    }
   301	    return true;
   302	}
   303	
   304	void set_oom(Op& op) { reply_err(op.sink(), "ERR out of memory"); }
