   101	def stats(c):
   102	    text = c.cmd("INFO", "stats")
   103	    out = {}
   104	    for line in text.split("\r\n"):
   105	        if ":" in line and line.startswith("sort_"):
   106	            key, value = line.split(":", 1)
   107	            out[key] = int(value)
   108	    return out
