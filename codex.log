   985	    uint32_t script_first = 0, script_count = 0;
   986	    if (kind == Kind::Script) {
   987	        if (!command_validate_script_route(op, script_first, script_count))
   988	            return ScatterPrepare::Error;
   989	        // Zero/one-key and feature-off activations retain the established local route. The later
   990	        // ScriptRoute pass owns the exact CROSSSLOT refusal when a disabled boot sees >1 owner.
   991	        if (script_count <= 1 || server.script_crossshard_max_bytes() == 0 ||
   992	            server.script_crossshard_workbench_bytes() == 0 ||
   993	            server.script_crossshard_cut_slots() == 0)
   994	            return ScatterPrepare::NotScatter;
   995	    }
