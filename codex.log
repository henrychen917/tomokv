   190	def phase_refused(c):
   191	    print("-- multi-executor: every '*'-bearing BY/GET is refused --")
   192	    before = stats(c)
   193	    for label, args in [
   194	        ("BY string pattern", ("SORT", "s:L", "BY", "s:w_*")),
   195	        ("BY hash-field pattern", ("SORT", "s:L", "BY", "s:h_*->f")),
   196	        ("BY on SORT_RO", ("SORT_RO", "s:L", "BY", "s:w_*")),
   197	        ("BY refused before a later syntax error", ("SORT", "s:L", "BY", "s:w_*", "BADTOKEN")),
   198	        ("BY refused with STORE", ("SORT", "s:L", "BY", "s:w_*", "STORE", "s:d")),
   199	        ("BY refused on a missing source", ("SORT", "s:none", "BY", "s:w_*")),
   200	    ]:
   201	        check_err(label, c.cmd(*args), "ERR " + DENY_BY)
   202	    for label, args in [
   203	        ("GET string pattern", ("SORT", "s:L", "GET", "s:d_*")),
   204	        ("GET hash-field pattern", ("SORT", "s:L", "GET", "s:h_*->g")),
   205	        ("GET on SORT_RO", ("SORT_RO", "s:L", "GET", "s:d_*")),
   206	        ("GET refused after an admitted BY", ("SORT", "s:L", "BY", "nosort", "GET", "s:d_*")),
   207	    ]:
   208	        check_err(label, c.cmd(*args), "ERR " + DENY_GET)
   209	    # Inside a transaction the refusal is an execution-time array element, exactly as it is for any
   210	    # other runtime error in EXEC, and the rest of the transaction still runs.
   211	    check("MULTI opens", c.cmd("MULTI"), "OK")
   212	    check("refused command queues", c.cmd("SORT", "s:L", "BY", "s:w_*"), "QUEUED")
   213	    check("admitted command queues", c.cmd("SORT", "s:L", "BY", "nosort"), "QUEUED")
   214	    replies = c.cmd("EXEC")
   215	    check_err("refusal inside EXEC", replies[0], "ERR " + DENY_BY)
   216	    check("EXEC continues past the refusal", replies[1], ["3", "1", "2"])
   217	    after = stats(c)
   218	    check("refusals counted", after["sort_deref_refusals"] - before["sort_deref_refusals"], 11)
   219	    # MECHANISM CONTROL: a refusal must happen BEFORE any key is read.
   220	    check("refusal phase performed no lookups",
   221	          after["sort_deref_lookups"] - before["sort_deref_lookups"], 0)
