   173	def required_geometry(c):
   174	    io_threads, ex_threads = placement(c)
   175	    shards = configured_shards(c)
   176	    if (io_threads, ex_threads, shards) != (6, 2, 16):
   177	        raise AssertionError(
   178	            "sort battery requires --shards 16 --ratio 6:2; got shards=%d ratio=%d:%d"
   179	            % (shards, io_threads, ex_threads))
   180	    elements = ["3", "1", "2"]
   181	    by = find_cross_owner_pattern(c, "s:L", "s:xby", elements, ex_threads)
   182	    get = find_cross_owner_pattern(c, "s:L", "s:xget", elements, ex_threads)
   183	    store = find_cross_owner_key(c, "s:L", "s:xstore", ex_threads)
   184	    print("  geometry: source shard %d -> BY shard %d (%s -> %s)"
   185	          % (by[3], by[4], by[1], by[2]))
   186	    print("  geometry: source shard %d -> GET shard %d (%s -> %s)"
   187	          % (get[3], get[4], get[1], get[2]))
   188	    print("  geometry: source shard %d -> STORE shard %d (%s)"
   189	          % (store[1], store[2], store[0]))
   190	    return {"by_pattern": by[0], "get_pattern": get[0], "store": store[0]}
   191	
