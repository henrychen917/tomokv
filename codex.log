   143	def phase_no_deref(c):
   144	    """Forms that read no derived key at all. These must behave identically in EVERY config."""
   145	    print("-- forms that dereference nothing --")
   146	    before = stats(c)
   147	    check("BY globless suppresses ordering", c.cmd("SORT", "s:L", "BY", "nosort"),
   148	          ["3", "1", "2"])
   149	    check("BY globless, other spelling", c.cmd("SORT", "s:L", "BY", "constant"),
   150	          ["3", "1", "2"])
   151	    # '?' and '[' are glob metacharacters but NOT substitution points: only '*' is.
   152	    check("BY '?' is not a substitution", c.cmd("SORT", "s:L", "BY", "?_w"), ["3", "1", "2"])
   153	    check("BY '[' is not a substitution", c.cmd("SORT", "s:L", "BY", "[ab]_w"), ["3", "1", "2"])
   154	    check("BY globless + DESC reverses a list",
   155	          c.cmd("SORT", "s:L", "BY", "nosort", "DESC"), ["2", "1", "3"])
   156	    check("BY globless + DESC reverses a zset",
   157	          c.cmd("SORT", "s:Z", "BY", "nosort", "DESC"), ["a", "c", "b"])
   158	    check("BY globless + LIMIT", c.cmd("SORT", "s:L", "BY", "nosort", "LIMIT", "1", "1"), ["1"])
   159	    check("BY globless + LIMIT past the end",
   160	          c.cmd("SORT", "s:L", "BY", "nosort", "LIMIT", "5", "5"), [])
   161	    check("BY globless + negative offset clamps",
   162	          c.cmd("SORT", "s:L", "BY", "nosort", "LIMIT", "-1", "2"), ["3", "1"])
   163	    check("GET # is the element", c.cmd("SORT", "s:L", "GET", "#"), ["1", "2", "3"])
   164	    check("GET # twice", c.cmd("SORT", "s:L", "GET", "#", "GET", "#"),
   165	          ["1", "1", "2", "2", "3", "3"])
   166	    check("BY globless + GET #", c.cmd("SORT", "s:L", "BY", "nosort", "GET", "#"),
   167	          ["3", "1", "2"])
   168	    # A GET pattern with no '*' never looks a key up; the reference answers a null per element.
   169	    check("GET globless is a constant null", c.cmd("SORT", "s:L", "GET", "literal"),
   170	          [None, None, None])
   171	    check("GET '##' is not the element", c.cmd("SORT", "s:L", "GET", "##"), [None, None, None])
   172	    check("BY globless + STORE", c.cmd("SORT", "s:L", "BY", "nosort", "STORE", "s:dl"), 3)
   173	    check("BY globless + STORE contents", c.cmd("LRANGE", "s:dl", "0", "-1"), ["3", "1", "2"])
   174	    check("GET null stores an empty element",
   175	          c.cmd("SORT", "s:L", "GET", "literal", "GET", "#", "STORE", "s:dm"), 6)
   176	    check("GET null STORE contents", c.cmd("LRANGE", "s:dm", "0", "-1"),
   177	          ["", "1", "", "2", "", "3"])
   178	    check("missing source with BY globless", c.cmd("SORT", "s:none", "BY", "nosort"), [])
   179	    check_err("wrong type source", c.cmd("SORT", "s:h_1", "BY", "nosort"), "WRONGTYPE")
   180	    check_err("syntax error precedes a later BY",
   181	              c.cmd("SORT", "s:L", "BADTOKEN", "BY", "s:w_*"), "ERR syntax error")
   182	    check_err("BY needs an argument", c.cmd("SORT", "s:L", "BY"), "ERR syntax error")
   183	    check_err("GET needs an argument", c.cmd("SORT", "s:L", "GET"), "ERR syntax error")
   184	    after = stats(c)
   185	    # MECHANISM CONTROL: not one of the forms above may read a derived key.
   186	    check("no-deref phase performed no lookups",
   187	          after["sort_deref_lookups"] - before["sort_deref_lookups"], 0)
