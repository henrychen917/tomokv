   509	          % (checks, len(failures), "PASS" if not failures else "FAIL"))
   510	    for line in failures[:15]:
   511	        print("  " + line)
   512	    return 1 if failures else 0
   513	
   514	
   515	if __name__ == "__main__":
   516	    sys.exit(main())

