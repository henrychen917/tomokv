   123	def shard_of(c, key):
   124	    shard = c.cmd("DEBUG", "SHARD", key)
   125	    if not isinstance(shard, int):
   126	        raise AssertionError("DEBUG SHARD is required, got %r for %s" % (shard, key))
   127	    return shard
