   359	def phase_ryow(c, one_executor):
   360	    """Read-your-own-writes across the dereference.
   361	
   362	    REGRESSION PIN. The read cut and the originating connection are per-shard state that the owning
   363	    task binds only on the shard it was posted for. A dereference reads OTHER shards, and reading
   364	    them at "latest, no connection" hides this connection's own not-yet-committed group -- so a
   365	    weight key written by the immediately preceding MSET read back as absent, and only on the boots
   366	    whose hash seed placed it off the source's shard. The loop below writes the weights and sorts by
   367	    them on the same connection many times, with weight names spread wide enough that some of them
   368	    land on another shard in any multi-shard placement.
   369	    """
   370	    print("-- read-your-own-writes through BY/GET --")
   371	    if not one_executor:
   372	        print("  (skipped: dereference is not admitted in this configuration)")
   373	        return
   374	    elements = [str(i) for i in range(12)]
   375	    c.cmd("DEL", "s:ry")
   376	    c.cmd("RPUSH", "s:ry", *elements)
   377	    for round_index in range(40):
   378	        weights = {e: (round_index * 37 + int(e) * 11) % 97 for e in elements}
   379	        pairs = []
   380	        for e in elements:
   381	            pairs += ["s:ryw_%s_%d" % (e, round_index), str(weights[e])]
   382	            pairs += ["s:ryd_%s_%d" % (e, round_index), "v%s" % e]
   383	        c.cmd("MSET", *pairs)
   384	        want = sorted(elements, key=lambda e: (weights[e], e.encode("latin1")))
   385	        check("ryow round %d order" % round_index,
   386	              c.cmd("SORT", "s:ry", "BY", "s:ryw_*_%d" % round_index), want)
   387	        check("ryow round %d projection" % round_index,
   388	              c.cmd("SORT", "s:ry", "BY", "s:ryw_*_%d" % round_index,
   389	                    "GET", "s:ryd_*_%d" % round_index),
   390	              ["v%s" % e for e in want])
   391	        c.cmd("DEL", *[p for i, p in enumerate(pairs) if i % 2 == 0])
   392	
   393	
   394	def phase_multi_ryow(c, one_executor):
   395	    """The dereference inside a transaction.
   396	
   397	    REGRESSION PIN, and the battery's sharpest detector. EXEC does not serialise commands globally:
   398	    each shard walks only the commands it PARTICIPATES in, so commands over disjoint shards proceed
   399	    independently. A dereferencing SORT breaks that premise -- its participant set cannot name the
   400	    shards its patterns will read, because those are only known after the source has been read. Left
   401	    as an ordinary one-key Local child it ran before an earlier MSET had been applied on the weight
   402	    keys' shards and sorted by the PREVIOUS weights. `make sortnoctx` builds the binary in which the
   403	    fix is compiled out; every check below must fail against it.
   404	    """
   405	    print("-- dereference inside MULTI/EXEC --")
   406	    if not one_executor:
   407	        print("  (skipped: dereference is not admitted in this configuration)")
   408	        return
   409	    elements = [str(i) for i in range(10)]
   410	    for round_index in range(20):
   411	        c.cmd("DEL", "s:mr")
   412	        c.cmd("RPUSH", "s:mr", *elements)
   413	        weights = {e: (round_index * 53 + int(e) * 17) % 101 for e in elements}
   414	        setup = []
   415	        for e in elements:
   416	            setup += ["s:mrw_%s" % e, str((weights[e] + 500))]      # a stale value first
   417	            setup += ["s:mrd_%s" % e, "old%s" % e]
   418	        c.cmd("MSET", *setup)
   419	        pairs = []
   420	        for e in elements:
   421	            pairs += ["s:mrw_%s" % e, str(weights[e])]
   422	            pairs += ["s:mrd_%s" % e, "new%s" % e]
   423	        want = sorted(elements, key=lambda e: (weights[e], e.encode("latin1")))
   424	        check("multi ryow %d queue MSET" % round_index, c.cmd("MULTI"), "OK")
   425	        check("multi ryow %d queued" % round_index, c.cmd("MSET", *pairs), "QUEUED")
   426	        c.cmd("SORT", "s:mr", "BY", "s:mrw_*")
   427	        c.cmd("SORT", "s:mr", "BY", "s:mrw_*", "GET", "s:mrd_*")
   428	        c.cmd("SORT", "s:mr", "BY", "s:mrw_*", "STORE", "s:mrdst")
   429	        replies = c.cmd("EXEC")
   430	        check("multi ryow %d order" % round_index, replies[1], want)
   431	        check("multi ryow %d projection" % round_index, replies[2],
   432	              ["new%s" % e for e in want])
   433	        check("multi ryow %d stored" % round_index, c.cmd("LRANGE", "s:mrdst", "0", "-1"), want)
   434	
   435	
   436	def phase_random(c, one_executor, rng):
   437	    """Random weight sets checked against a Python model of the reference's rules."""
   438	    print("-- randomised model comparison --")
   439	    if not one_executor:
   440	        print("  (skipped: dereference is not admitted in this configuration)")
   441	        return
   442	    for trial in range(60):
   443	        n = rng.randint(1, 12)
   444	        elements = [str(rng.randint(0, 40)) for _ in range(n)]
   445	        elements = list(dict.fromkeys(elements))          # SORT of a list, distinct for clarity
   446	        c.cmd("DEL", "s:r")
   447	        c.cmd("RPUSH", "s:r", *elements)
   448	        weights = {}
   449	        for element in elements:
   450	            if rng.random() < 0.25:
   451	                continue                                   # missing -> NULL weight
   452	            weights[element] = rng.randint(-500, 500)
   453	            c.cmd("SET", "s:rw_" + element, str(weights[element]))
   454	        for element in elements:
   455	            if rng.random() < 0.3:
   456	                c.cmd("DEL", "s:rd_" + element)
   457	            else:
   458	                c.cmd("SET", "s:rd_" + element, "v" + element)
   459	        desc = rng.random() < 0.5
   460	        # Numeric ordering: a missing weight is zero, and equal weights fall back to a byte
   461	        # comparison of the ELEMENTS -- a total order, so the model is exact.
   462	        order = sorted(elements,
   463	                       key=lambda e: (weights.get(e, 0), e.encode("latin1")),
   464	                       reverse=desc)
   465	        args = ["SORT", "s:r", "BY", "s:rw_*"]
   466	        if desc:
   467	            args.append("DESC")
   468	        check("random %d order" % trial, c.cmd(*args), order)
   469	        args = ["SORT", "s:r", "BY", "s:rw_*"] + (["DESC"] if desc else []) + \
   470	               ["GET", "#", "GET", "s:rd_*"]
   471	        want = []
   472	        for element in order:
   473	            want.append(element)
   474	            got_key = c.cmd("EXISTS", "s:rd_" + element)
   475	            want.append("v" + element if got_key else None)
   476	        check("random %d projection" % trial, c.cmd(*args), want)
   477	        for element in elements:
   478	            c.cmd("DEL", "s:rw_" + element, "s:rd_" + element)
   479	
