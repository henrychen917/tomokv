# 2026-10-23 02:00:42 NT4.8 follow-up: proto-max-bulk-len up to LONG_MAX vs 32-bit string values (2s, uring, CPUs 64-71, client 72-79)
## probe script
#!/bin/bash
# Usage: setrange_repro.sh BINARY PORT OUTDIR  -- boots BINARY (2s/uring) on CPUs 64-71 and probes the >4 GiB SETRANGE path.
BIN=$1; PORT=$2; OUT=$3; CLI=/home/user/Projects/redis74/src/redis-cli
mkdir -p "$OUT"; cd "$OUT"
taskset -c 64-71 "$BIN" --port "$PORT" --bind 127.0.0.1 --protected-mode no --save '' --appendonly no \
  --dir "$OUT" --thread-mode 2s --ratio 6:2 --shards 16 --net-io uring > server.log 2>&1 &
echo $! > server.pid
for i in $(seq 100); do taskset -c 72-79 $CLI -p "$PORT" PING >/dev/null 2>&1 && break; sleep 0.1; done
c(){ echo "> $*"; timeout 30 taskset -c 72-79 $CLI -p "$PORT" "$@" 2>&1; echo "  (rc=$?)"; }
c CONFIG SET proto-max-bulk-len 9223372036854775807
c SETRANGE k 4294967296 x
c STRLEN k
c PING
PID=$(cat server.pid)
if ps -p "$PID" -o args= | grep -q -- "--port $PORT"; then echo "server alive; stopping $PID"; kill "$PID"; wait "$PID"; echo "exit=$?"; else wait "$PID"; echo "server DEAD exit=$?"; fi
tail -5 server.log

