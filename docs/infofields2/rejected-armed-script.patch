+// Selected only by the already-armed IO MONITOR feed. The clean Lua closures
+// and every ordinary command body remain the original implementation.
+__attribute__((cold, noinline)) void IoLoop::climon_monitor_feed(Shard& shard, Op& op) {
+    lua_State* state = script_thread_state();
+    if (!state) {
+        op.spec->handler_notify(shard, op);
+        return;
+    }
+    lua_getglobal(state, "redis");
+    int saved[2];
+    const char* names[] = {"call", "pcall"};
+    for (int i = 0; i != 2; ++i) {
+        lua_getfield(state, -1, names[i]);
+        saved[i] = luaL_ref(state, LUA_REGISTRYINDEX);
+        lua_pushlightuserdata(state, &t_lua_engine.current);
+        lua_pushboolean(state, i != 0);
+        lua_pushcclosure(state, [](lua_State* state) __attribute__((cold, noinline)) -> int {
+            const bool protected_call = lua_toboolean(state, lua_upvalueindex(2));
+            ScriptContext* context = t_lua_engine.current;
+            const uint32_t argc = static_cast<uint32_t>(lua_gettop(state));
+            bool admitted = context && argc;
+            for (uint32_t i = 1; i <= argc && admitted; ++i) {
+                const int type = lua_type(state, i);
+                admitted = type == LUA_TSTRING || type == LUA_TNUMBER;
+            }
+            const CommandSpec* spec = nullptr;
+            if (admitted) {
+                size_t length = 0;
+                const char* name = lua_tolstring(state, 1, &length);
+                spec = command_lookup(Slice(name, length));
+                admitted = spec && command_arity_ok(*spec, argc) &&
+                    script_command_allowed(*spec, argc) &&
+                    !(context->readonly && (spec->flags & CmdFlags::Write));
+            }
+            if (admitted) {
+                size_t length = 0;
+                const char* value = lua_tolstring(state, spec->first_key + 1, &length);
+                Slice key(value, length);
+                key.set_namespace(context->parent->physical_db);
+                bool declared = false;
+                for (uint32_t i = 0; i < context->key_count; ++i)
+                    declared |= context->parent->arg(context->key_first + i) == key;
+                admitted = declared && (!(spec->flags & CmdFlags::DenyOom) ||
+                    context->shard->store().budget_admit(key));
+            }
+            // Use the same dispatcher, protected so executed errors can also be
+            // fed. Re-raise its unchanged error table for redis.call afterwards.
+            int (* volatile dispatch)(lua_State*, bool) = redis_dispatch;
+            dispatch(state, true);
+            if (admitted)
+                climon_monitor_feed(*context->shard, *context->parent, state, argc);
+            if (!protected_call && lua_istable(state, -1)) {
+                lua_getfield(state, -1, "err");
+                const bool error = !lua_isnil(state, -1);
+                lua_pop(state, 1);
+                if (error) return lua_error(state);
+            }
+            return 1;
+        }, 2);
+        lua_setfield(state, -2, names[i]);
+    }
+    lua_pop(state, 1);
+    op.spec->handler_notify(shard, op);
+    // The handler leaves the same persistent interpreter alive and its stack empty.
+    lua_getglobal(state, "redis");
+    for (int i = 0; i != 2; ++i) {
+        lua_rawgeti(state, LUA_REGISTRYINDEX, saved[i]);
+        lua_setfield(state, -2, names[i]);
+        void (* volatile unref)(lua_State*, int, int) = luaL_unref;
+        unref(state, LUA_REGISTRYINDEX, saved[i]);
+    }
+    lua_pop(state, 1);
+}
