-    bool init(const TlsContext& context, TlsAuthClients auth, int fd, bool try_ktls,
+    bool init(const TlsContext& context, TlsAuthClients auth, int fd,
               std::string& error);
 
     bool handshaking() const { return state_ == State::Handshaking; }
