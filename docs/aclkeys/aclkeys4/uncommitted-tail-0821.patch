+++ b/src/cmd/blocking_debug.cc
@@ -31,4 +31,12 @@ void debug_xread_registration_command(Op& op) {
     reply_ok(op.sink());
 }
 
+// Keep the ordinary DEBUG implementation intact across mainline merges. Its
+// isolated extension is selected only after DEBUG's existing permission check.
+bool debug_xread_registration_dispatch(Op& op) {
+    if (!op.arg(1).eq_icase("xread-registration-hold")) return false;
+    debug_xread_registration_command(op);
+    return true;
+}
+
 }  // namespace tomo
